[Desktop Entry]
Type=Application
Name=Music
GenericName=Music player
Comment=Play the songs in your Music folder
Exec=wildos-music %U
Icon=wildos-music
Terminal=false
StartupNotify=true
StartupWMClass=wildos-music
Categories=Qt;AudioVideo;Audio;Player;
MimeType=audio/mpeg;audio/mp3;audio/x-mp3;audio/flac;audio/x-flac;audio/ogg;audio/x-vorbis+ogg;audio/vorbis;audio/x-opus+ogg;audio/opus;audio/mp4;audio/x-m4a;audio/m4a;audio/aac;audio/x-aac;audio/wav;audio/x-wav;audio/vnd.wave;audio/aiff;audio/x-aiff;audio/x-ms-wma;audio/x-ape;audio/x-wavpack;audio/x-musepack;audio/x-mpegurl;audio/mpegurl;application/vnd.apple.mpegurl;
Keywords=music;songs;player;audio;mp3;flac;albums;artists;playlist;itunes;media player;groove;
X-DBUS-StartupType=Unique
X-DBUS-ServiceName=org.wildos.music
