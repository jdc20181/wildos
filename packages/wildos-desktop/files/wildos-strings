#!/usr/bin/python3
"""Rewords KDE's interface text the way Wild OS speaks.

KDE apps and Plasma look up their text in gettext catalogues found through
XDG_DATA_DIRS, and /usr/share/wildos comes first in a Wild OS session (see
/etc/xdg/plasma-workspace/env/wildos.sh). This script copies the stock UK
English catalogues into /usr/share/wildos/locale with Wild OS's wording, so
nothing KDE ships is modified and app updates keep working: the dpkg trigger
in wildos-desktop reruns it whenever a catalogue changes.

Three passes, in order:
  1. Menu-sized labels in the domains a switcher meets every day go from
     KDE's Title Case to sentence case ("Sort By" becomes "Sort by"). The
     UK English catalogue often lacks the newest strings, which would then
     show in KDE's US Title Case, so the full list of strings is taken from
     every installed language's catalogue for the domain (they all carry
     the same source text) and the missing ones are added.
  2. Words are swapped: KDE's "Wastebin" is the Windows "Recycle bin", and
     app names become the plain names Start shows ("Dolphin" is "Files").
  3. Hand-written entries in /usr/share/wildos/strings/en_GB/<domain>.po win
     over everything.

English text is only looked up when the language list holds en_GB (en_US is
KDE's source language and never reads a catalogue), so the session sets
LANGUAGE=en_GB for English locales.
"""

import ast
import os
import re
import struct
import sys

LANG = "en_GB"
LOCALE = "/usr/share/locale"
SRC = f"{LOCALE}/{LANG}/LC_MESSAGES"
OVERRIDES = f"/usr/share/wildos/strings/{LANG}"
DST = f"/usr/share/wildos/locale/{LANG}/LC_MESSAGES"

