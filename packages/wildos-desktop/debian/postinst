#!/bin/sh
set -e

# Kicksecure's desktop helpers are built for its own LXQt desktop and show
# technical pop-ups (system check warnings, update checks, a deprecation
# notice, a time-sync tray icon, and a display resize helper written for
# wlroots desktops that fails and restarts every few seconds under KWin,
# and a shared-folder bookmark for virtual machines that fails at every
# sign-in on a real computer).
# Wild OS surfaces the same information in
# plain English through the security chip and the Store, so the helpers are
# taken out of autostart. A diversion survives updates of the packages that
# own these files. The services themselves keep running where they matter
# (sdwdate still sets the clock).
DISABLED=/usr/share/wildos/autostart-disabled
AUTOSTART="
legacy-dist-deprecation-notice.desktop
msgdispatcher.desktop
systemcheck.desktop
updatecheck.desktop
sdwdate-gui.desktop
wlr-resize-watcher.desktop
config-mnt-shared-bookmark.desktop
"

if [ "$1" = "triggered" ]; then
    /usr/libexec/wildos/wildos-app-names
    /usr/libexec/wildos/wildos-strings
fi

if [ "$1" = "configure" ]; then
    /usr/libexec/wildos/wildos-app-names
    /usr/libexec/wildos/wildos-strings
    mkdir -p "$DISABLED"
    for f in $AUTOSTART; do
        dpkg-divert --package wildos-desktop --add --rename \
            --divert "$DISABLED/$f" "/etc/xdg/autostart/$f" >/dev/null
    done
fi

#DEBHELPER#
