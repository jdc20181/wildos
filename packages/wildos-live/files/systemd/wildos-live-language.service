[Unit]
Description=Wild OS live language from the start-up menu
DefaultDependencies=no
After=local-fs.target
Before=display-manager.service sddm.service systemd-localed.service
ConditionKernelCommandLine=wildos.lang

[Service]
Type=oneshot
ExecStart=/usr/libexec/wildos-live/live-language

[Install]
WantedBy=multi-user.target
