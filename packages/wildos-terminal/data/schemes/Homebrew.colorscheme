# macOS Terminal's Homebrew profile: black, #28fe14 text, brighter green
# for bold, over Terminal's ANSI palette. Its blue (#0225c7) is lifted so
# folders in ls stay readable on black.

[Background]
Color=0,0,0

[BackgroundIntense]
Color=0,0,0

[Color0]
Color=0,0,0

[Color0Intense]
Color=104,104,104

[Color1]
Color=201,27,0

[Color1Intense]
Color=255,110,103

[Color2]
Color=0,194,0

[Color2Intense]
Color=95,250,104

[Color3]
Color=199,196,0

[Color3Intense]
Color=255,252,103

[Color4]
Color=47,92,255

[Color4Intense]
Color=104,113,255

[Color5]
Color=201,48,199

[Color5Intense]
Color=255,119,255

[Color6]
Color=0,197,199

[Color6Intense]
Color=96,253,255

[Color7]
Color=199,199,199

[Color7Intense]
Color=255,255,255

[Foreground]
Color=40,254,20

[ForegroundIntense]
Bold=true
Color=93,255,77

[General]
Description=Homebrew
Opacity=1
