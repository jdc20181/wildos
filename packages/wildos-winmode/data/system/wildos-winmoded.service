[Unit]
Description=Windows mode
# Stopped before libvirt-guests, which would otherwise shut Windows down
# under a save to disk that is still being written.
After=libvirtd.service virtqemud.service libvirt-guests.service network.target

[Service]
# Started on demand over D-Bus, never at boot: Windows itself only starts
# when someone opens a Windows app (brief 5.6).
Type=dbus
BusName=org.wildos.WindowsMode1
ExecStart=/usr/libexec/wildos/winmoded
# Pausing or saving Windows can take a while with several GB in memory.
TimeoutStopSec=120
# A save to disk under way at shutdown is let finish (main() waits for
# it): only winmoded itself is asked to stop, not the virsh doing the save.
KillMode=mixed
