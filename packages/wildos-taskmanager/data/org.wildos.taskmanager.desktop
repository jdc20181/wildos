[Desktop Entry]
Type=Application
Name=Task Manager
GenericName=Task manager
Comment=See and end what is running, and how hard your computer is working
Exec=wildos-taskmanager
Icon=org.wildos.taskmanager
Terminal=false
StartupNotify=true
StartupWMClass=wildos-taskmanager
Categories=Qt;System;Monitor;
Keywords=task manager;processes;performance;end task;kill;cpu;memory;startup;services;system monitor;
X-KDE-Shortcuts=Ctrl+Shift+Esc
