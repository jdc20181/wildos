[Global]
IconName=applets-screenshooter
Comment=Screenshot
DesktopEntry=org.wildos.screenshot

[Event/captured]
Name=Screenshot taken
Comment=A screenshot was copied and saved
Action=Popup

[Event/recorded]
Name=Screen recording saved
Comment=A screen recording finished and was saved
Action=Popup

[Event/failed]
Name=Screenshot failed
Comment=A screenshot or recording could not be made
Action=Popup
