#!/bin/sh
# KWin runs its "not responding" helper by a fixed path. Wild OS's prompt
# takes that path; KWin's own helper is kept beside it, renamed.
set -e

case "$(dpkg --print-architecture)" in
    amd64) triplet=x86_64-linux-gnu ;;
    arm64) triplet=aarch64-linux-gnu ;;
    *) triplet="$(dpkg --print-architecture)-linux-gnu" ;;
esac
helper=/usr/lib/$triplet/libexec/kwin_killer_helper

if [ "$1" = install ] || [ "$1" = upgrade ]; then
    dpkg-divert --package wildos-system-dialogs --add --rename \
        --divert "$helper.kde" "$helper"
fi

#DEBHELPER#
