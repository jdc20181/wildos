#!/bin/sh
set -e

case "$(dpkg --print-architecture)" in
    amd64) triplet=x86_64-linux-gnu ;;
    arm64) triplet=aarch64-linux-gnu ;;
    *) triplet="$(dpkg --print-architecture)-linux-gnu" ;;
esac
helper=/usr/lib/$triplet/libexec/kwin_killer_helper

if [ "$1" = remove ] || [ "$1" = abort-install ] || [ "$1" = disappear ]; then
    dpkg-divert --package wildos-system-dialogs --remove --rename \
        --divert "$helper.kde" "$helper"
fi

# The kernel holds the 32-bit helper open while its entry is registered.
if [ "$1" = remove ]; then
    [ -e /proc/sys/fs/binfmt_misc/wildos-32bit ] && echo -1 > /proc/sys/fs/binfmt_misc/wildos-32bit || true
    rm -f /run/binfmt.d/wildos-32bit.conf
fi

if [ "$1" = purge ]; then
    rm -f /var/lib/wildos/package-sources /var/lib/wildos/package-sources.new
fi

#DEBHELPER#
