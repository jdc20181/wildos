<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- The password prompts behind Settings. Each action runs one helper in
     /usr/libexec/wildos, which takes only its own fixed requests:
     settings-update-policy (Updates), settings-users and
     settings-fingerprint (Accounts),
     settings-locale (Time and language), settings-protection (Privacy
     and security), settings-network (the VPN kill switch) and
     settings-brave-spelling (Typing). -->
<policyconfig>
  <vendor>Wild OS</vendor>
  <vendor_url>https://wildos.io</vendor_url>

  <action id="org.wildos.settings.update-policy">
    <description>Change how updates are installed</description>
    <message>Change how Wild OS installs updates?</message>
    <icon_name>preferences-system</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/wildos/settings-update-policy</annotate>
  </action>

  <action id="org.wildos.settings.protection">
    <description>Change the protection level</description>
    <message>Change how strongly Wild OS protects this computer?</message>
    <icon_name>security-high</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/wildos/settings-protection</annotate>
  </action>

  <action id="org.wildos.settings.cpu-threads">
    <description>Turn hyper-threading on or off</description>
    <message>Change whether this computer uses hyper-threading?</message>
    <icon_name>cpu</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/wildos/settings-cpu-threads</annotate>
  </action>

  <action id="org.wildos.settings.graphics-driver">
    <description>Change the graphics driver</description>
    <message>Change which driver your NVIDIA graphics card uses?</message>
    <icon_name>video-display</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/wildos/settings-graphics-driver</annotate>
  </action>

  <action id="org.wildos.settings.fingerprint">
    <description>Choose where fingerprints can be used</description>
    <message>Change where a fingerprint can be used instead of the password?</message>
    <icon_name>security-high</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/wildos/settings-fingerprint</annotate>
  </action>

  <action id="org.wildos.settings.network">
    <description>Turn the VPN kill switch on or off</description>
    <message>Change whether Wild OS blocks the internet when a VPN drops?</message>
    <icon_name>network-vpn</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/wildos/settings-network</annotate>
  </action>

  <!-- No password: it only sets which languages Brave checks spelling in,
       from a fixed list, in one file of its own. -->
  <action id="org.wildos.settings.brave-spelling">
    <description>Set the languages Brave checks spelling in</description>
    <message>Change the languages Brave checks spelling in?</message>
    <icon_name>tools-check-spelling</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/wildos/settings-brave-spelling</annotate>
  </action>

  <action id="org.wildos.settings.users">
    <description>Change the accounts on this computer</description>
    <message>Change who can use this computer?</message>
    <icon_name>system-users</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/wildos/settings-users</annotate>
  </action>

  <action id="org.wildos.settings.locale">
    <description>Add a language to this computer</description>
    <message>Set up a new language on this computer?</message>
    <icon_name>preferences-desktop-locale</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/wildos/settings-locale</annotate>
  </action>
</policyconfig>
