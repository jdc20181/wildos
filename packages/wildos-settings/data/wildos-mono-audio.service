[Unit]
Description=Mono audio for Wild OS accessibility
After=pipewire.service wireplumber.service
BindsTo=pipewire.service

[Service]
LockPersonality=yes
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
Type=simple
ExecStart=/usr/bin/pipewire -c wildos-mono-audio.conf
Restart=on-failure
Slice=session.slice

[Install]
WantedBy=pipewire.service
