#!/bin/sh
# Applies the protection level chosen in Settings > Privacy and security.
# Runs as root through pkexec (org.wildos.settings.policy), and at start-up
# from wildos-protection.service to load the firewall again. Takes only the
# requests below.
#
#   standard   What Wild OS ships: the hardened system, with a firewall
#              that turns away anything arriving unasked and lets
#              everything this computer starts go out.
#   strict     Standard, plus USB devices found at start-up wait for
#              permission like ones plugged in later.
#   maximum    Strict, plus the firewall blocks network discovery (finding
#              printers and screens), Bluetooth is off and the camera's
#              driver is blocked.
#   boot       Loads the firewall for the saved level (the service's job).
#
# The screen lock times that go with each level belong to the person, not
# the system, so Settings sets those itself.

set -eu

LEVEL_FILE=/etc/wildos/protection-level
USBGUARD_CONF=/etc/usbguard/usbguard-daemon.conf
USBGUARD_RULES=/etc/usbguard/rules.d/50-wildos-protection.conf
CAMERA_BLOCK=/etc/modprobe.d/60-wildos-protection-camera.conf
TABLE=wildos_protection
# Written once nft has taken the rules, so security-status (which runs
# without root and cannot list them) can say the firewall is up.
FIREWALL_MARK=/run/wildos/firewall

saved_level() {
    level=$(cat "$LEVEL_FILE" 2>/dev/null || true)
    case "$level" in strict | maximum) echo "$level" ;; *) echo standard ;; esac
}

# Incoming connections are refused unless they answer something this
# computer asked for. The Windows mode bridge (virbr-wildos) stays open:
# Windows gets its address and DNS from this computer through it, and
# Windows mode's own table (wildos_win) already limits what may come in
# there. A drop here would be final whatever that table allows. mDNS stays
# open at Standard and Strict, which is how printers and screens on the
# network are found. Nothing outgoing is limited at any level.
firewall() {
    rm -f "$FIREWALL_MARK"
    nft delete table inet "$TABLE" 2>/dev/null || true
    command -v nft >/dev/null || return 0
    discovery='udp dport 5353 accept'
    [ "$1" = maximum ] && discovery=''
    nft -f - <<EOF
table inet $TABLE {
    chain input {
        type filter hook input priority filter; policy drop;
        ct state established,related accept
        ct state invalid drop
        iif lo accept
        iifname { "virbr-wildos", "wildos-win*" } accept
        meta l4proto ipv6-icmp accept
        icmp type { echo-reply, destination-unreachable, time-exceeded, parameter-problem } accept
        udp sport 67 udp dport 68 accept
        udp sport 547 udp dport 546 accept
        $discovery
    }
}
EOF
    mkdir -p "$(dirname "$FIREWALL_MARK")"
    echo "$1" > "$FIREWALL_MARK"
    chmod 644 "$FIREWALL_MARK"
}

# Every device attached when Strict is chosen is allowed first, so nothing
# the person is using stops working; after that, a device that is present
# at start-up but was never allowed waits for permission.
usb() {
    [ -f "$USBGUARD_CONF" ] || return 0
    if [ "$1" = standard ]; then
        sed -i 's/^PresentDevicePolicy=.*/PresentDevicePolicy=allow/' "$USBGUARD_CONF"
        rm -f "$USBGUARD_RULES"
    else
        if [ ! -s "$USBGUARD_RULES" ] && command -v usbguard >/dev/null; then
            mkdir -p "$(dirname "$USBGUARD_RULES")"
            usbguard generate-policy --no-hashes > "$USBGUARD_RULES.new" 2>/dev/null || : > "$USBGUARD_RULES.new"
            chmod 600 "$USBGUARD_RULES.new"
            mv -f "$USBGUARD_RULES.new" "$USBGUARD_RULES"
        fi
        sed -i 's/^PresentDevicePolicy=.*/PresentDevicePolicy=apply-policy/' "$USBGUARD_CONF"
    fi
    systemctl try-restart usbguard.service || true
}

# Bluetooth and the camera are only touched going into or out of Maximum,
# so a choice made elsewhere (Bluetooth off in quick settings) is left
# alone.
bluetooth() {
    if [ "$1" = maximum ]; then
        systemctl disable --now bluetooth.service >/dev/null 2>&1 || true
        rfkill block bluetooth 2>/dev/null || true
    elif [ "$2" = maximum ]; then
        rfkill unblock bluetooth 2>/dev/null || true
        systemctl enable --now bluetooth.service >/dev/null 2>&1 || true
    fi
}

camera() {
    if [ "$1" = maximum ]; then
        printf '%s\n' '# Written by Wild OS Settings: Maximum protection blocks the camera.' \
            'install uvcvideo /bin/false' > "$CAMERA_BLOCK"
        modprobe -r uvcvideo 2>/dev/null || true
    elif [ -f "$CAMERA_BLOCK" ]; then
        rm -f "$CAMERA_BLOCK"
        # The camera works again without a restart.
        modprobe uvcvideo 2>/dev/null || true
    fi
}

case "${1:-}" in
    standard | strict | maximum)
        previous=$(saved_level)
        mkdir -p "$(dirname "$LEVEL_FILE")"
        firewall "$1"
        usb "$1"
        bluetooth "$1" "$previous"
        camera "$1"
        # Strict and Maximum keep every CPU flaw protection on, so hyper-threading
        # goes off from the next start-up. Standard leaves the person's choice.
        if [ "$1" != standard ] && [ -x /usr/libexec/wildos/settings-cpu-threads ]; then
            /usr/libexec/wildos/settings-cpu-threads off || true
        fi
        if [ "$1" = standard ]; then
            rm -f "$LEVEL_FILE"
        else
            echo "$1" > "$LEVEL_FILE"
        fi
        # Standard relaxes a few of Kicksecure's start-up options for speed
        # (/etc/default/grub.d/40_wildos.cfg reads the saved level), so
        # crossing between Standard and the stricter levels rebuilds the
        # start-up menu. It takes effect from the next start-up.
        case "$previous:$1" in
            standard:strict | standard:maximum | strict:standard | maximum:standard)
                if command -v update-grub >/dev/null 2>&1; then
                    update-grub >/dev/null 2>&1 || true
                fi
                ;;
        esac
        ;;
    boot)
        firewall "$(saved_level)"
        ;;
    *)
        echo "usage: settings-protection standard|strict|maximum|boot" >&2
        exit 2
        ;;
esac
