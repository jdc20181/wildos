<?xml version="1.0" encoding="UTF-8"?>
<!--
  Title bar metrics of the Aurorae theme Wild OS ships (aurorae/WildOS/WildOSrc,
  [Layout]). KWin effects cannot read other files, so they are repeated here
  and can be overridden in kwinrc under [Effect-org.wildos.snap] if the theme
  changes. They are only used for windows whose title bar is the height these
  values produce; other decorations fall back to Breeze's arithmetic or to
  square buttons the height of the title bar.
-->
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
    <kcfgfile name=""/>
    <group name="">
        <entry name="TitleHeight" type="Int"><default>42</default></entry>
        <entry name="TitleEdgeTop" type="Int"><default>0</default></entry>
        <entry name="TitleEdgeBottom" type="Int"><default>0</default></entry>
        <entry name="TitleEdgeRight" type="Int"><default>0</default></entry>
        <entry name="TitleEdgeTopMaximized" type="Int"><default>0</default></entry>
        <entry name="TitleEdgeBottomMaximized" type="Int"><default>0</default></entry>
        <entry name="TitleEdgeRightMaximized" type="Int"><default>0</default></entry>
        <entry name="ButtonWidthClose" type="Int"><default>46</default></entry>
        <entry name="ButtonWidthMaximizeRestore" type="Int"><default>46</default></entry>
        <entry name="ButtonHeight" type="Int"><default>42</default></entry>
        <entry name="ButtonSpacing" type="Int"><default>0</default></entry>
        <entry name="ButtonMarginTop" type="Int"><default>0</default></entry>
        <entry name="ButtonMarginTopMaximized" type="Int"><default>0</default></entry>
        <!-- Aurorae's ButtonSize factor (auroraerc), needed only below 1.0, where it does not change the title bar height. -->
        <entry name="ButtonSizeFactor" type="Double"><default>1.0</default></entry>
        <!--
          Written by Settings > System > Multitasking. The effect stays loaded
          while either is on, so snap assist works without the layout picker.
        -->
        <entry name="ShowLayouts" type="Bool"><default>true</default></entry>
        <entry name="SnapAssist" type="Bool"><default>true</default></entry>
    </group>
</kcfg>
