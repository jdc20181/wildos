[Icon Theme]
Name=Wild OS
Comment=Wild OS app, document and interface icons on the Fluent icon theme
Inherits=Fluent-yellow-light,breeze,hicolor
Example=folder
DisplayDepth=32
# Lets KIconLoader swap in the colour scheme for the symbolic glyphs, and
# makes it honour -symbolic names instead of falling back to plain ones.
FollowsColorScheme=true

# Directories are listed small first: KIconLoader keeps the first of two
# equally good matches, so a 16 px lookup lands on the simplified drawings
# and the 2-unit glyph strokes before the scalable ones.
Directories=16x16/symbolic,scalable/symbolic,16x16/apps,scalable/apps,16x16/mimetypes,scalable/mimetypes,scalable/devices,scalable/places

[16x16/symbolic]
Size=16
MinSize=8
MaxSize=20
Context=Status
Type=Scalable

[scalable/symbolic]
Size=24
MinSize=21
MaxSize=32
Context=Status
Type=Scalable

[16x16/apps]
Size=16
Context=Applications
Type=Fixed

[scalable/apps]
Size=48
MinSize=16
MaxSize=512
Context=Applications
Type=Scalable

[16x16/mimetypes]
Size=16
Context=MimeTypes
Type=Fixed

[scalable/mimetypes]
Size=48
MinSize=16
MaxSize=512
Context=MimeTypes
Type=Scalable

[scalable/devices]
Size=64
MinSize=16
MaxSize=512
Context=Devices
Type=Scalable

[scalable/places]
Size=64
MinSize=16
MaxSize=512
Context=Places
Type=Scalable
