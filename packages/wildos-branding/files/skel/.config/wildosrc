# Hot corners for new accounts (Settings > Multitasking). The bottom
# corners sit beside Start and the show desktop end of the taskbar, so they
# do nothing until chosen. Accounts made before hot corners had these keep
# the corners they had: KWin's wildos_hotcorners plugin copies them over once.
[HotCorners]
TopLeft=taskview
TopRight=notifications
BottomLeft=none
BottomRight=none
