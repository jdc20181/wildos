[%General]
author=Wild OS
comment=Wild OS office controls: light glass, Albert Sans, one accent. Pieces are generated by generate.py from the design tokens.
x11drag=menubar_and_primary_toolbar
alt_mnemonic=true
left_tabs=true
attach_active_tab=false
mirror_doc_tabs=false
group_toolbar_buttons=false
toolbar_item_spacing=2
toolbar_interior_spacing=6
toolbar_separator_thickness=1
spread_progressbar=true
composite=true
# Menus are glass-menu with 14px corners, 6px of padding around the rows
# (menu_padding needs the Wild OS Kvantum patch) and a soft shadow drawn in
# their outer 12px ("menu-shadow" in the SVG). Behind the glass the
# compositor blurs, with the blur's corners matching the menu's.
menu_shadow_depth=12
menu_padding=6
popup_blurring=true
menu_blur_radius=14
tooltip_shadow_depth=0
tooltip_blur_radius=6
# The colours the SVG draws the accent with (accent, hover, pressed). The
# Wild OS Kvantum patch swaps them for the accent picked in Settings.
# generate.py keeps this line in step with the drawing.
accent_colors=#3563d8,#315cc8,#2d54b7
menu_separator_height=9
splitter_width=5
scroll_width=8
scroll_arrows=false
scroll_min_extent=40
scrollbar_in_view=true
transient_scrollbar=true
transient_groove=false
slider_width=8
slider_handle_width=16
slider_handle_length=16
tickless_slider_handle_size=16
center_toolbar_handle=true
check_size=18
textless_progressbar=false
progressbar_thickness=8
menubar_mouse_tracking=true
toolbutton_style=0
click_behavior=0
translucent_windows=false
blurring=false
vertical_spin_indicators=false
inline_spin_indicators=true
inline_spin_separator=false
spin_button_width=24
fill_rubberband=true
merge_menubar_with_toolbar=false
small_icon_size=16
large_icon_size=32
button_icon_size=16
toolbar_icon_size=16
combo_as_lineedit=true
square_combo_button=false
animate_states=true
combo_menu=true
hide_combo_checkboxes=true
combo_focus_rect=false
groupbox_top_label=true
joined_inactive_tabs=false
no_inactive_tab_expansion=true
bold_active_tab=false
layout_spacing=8
layout_margin=12
submenu_overlap=0
submenu_delay=200
tooltip_delay=-1
tree_branch_line=false
dark_titlebar=false
no_inactiveness=true
respect_darkness=true
shadowless_popup=false
kinetic_scrolling=false
menu_blur_radius=0
tooltip_blur_radius=0
reduce_menu_opacity=0
centered_forms=false

[GeneralColors]
window.color=#f3f3f3
base.color=#fbfbfb
alt.base.color=#eeeeee
button.color=#ebebeb
light.color=#ffffff
mid.light.color=#f3f3f3
dark.color=#c6c6c6
mid.color=#dfdfdf
highlight.color=#3563d8
inactive.highlight.color=#3563d8
tooltip.base.color=#f0f0f0
text.color=#1a1a1a
window.text.color=#1a1a1a
button.text.color=#1a1a1a
disabled.text.color=#1a1a1a71
tooltip.text.color=#1a1a1a
highlight.text.color=#ffffff
link.color=#2a55c4
link.visited.color=#6a4bc4
progress.indicator.text.color=#1a1a1a

[Hacks]
transparent_ktitle_label=true
transparent_dolphin_view=false
transparent_pcmanfm_sidepane=true
transparent_pcmanfm_view=false
transparent_menutitle=true
transparent_arrow_button=true
blur_translucent=false
respect_darkness=true
force_size_grip=false
iconless_pushbutton=true
iconless_menu=false
disabled_icon_opacity=45
lxqtmainmenu_iconsize=16
normal_default_pushbutton=false
single_top_toolbar=false
tint_on_mouseover=0
no_selection_tint=true
middle_click_scroll=false
kcapacitybar_as_progressbar=true

[PanelButtonCommand]
frame=true
frame.element=button
frame.top=8
frame.bottom=8
frame.left=8
frame.right=8
interior=true
interior.element=button
indicator.element=arrow
indicator.size=12
text.normal.color=#1a1a1a
text.focus.color=#1a1a1a
text.press.color=#1a1a1a
text.toggle.color=#1a1a1a
# Default (primary) buttons are drawn at weight 600, the design's primary
# label; other labels stay regular.
text.boldness=2
text.shadow=false
text.margin.top=2
text.margin.bottom=2
text.margin.left=8
text.margin.right=8
text.iconspacing=8
min_width=80
min_height=32
frame.expansion=0
# Keyboard focus draws "<element>-focus" around the whole control (buttons,
# drop-downs, tool buttons, tabs). Sections without such a piece turn it off.
focusFrame=true

[PanelButtonTool]
inherits=PanelButtonCommand
min_width=0
min_height=0
text.margin.left=2
text.margin.right=2
frame.element=tbutton
interior.element=tbutton

[ToolbarButton]
