# Brave is the default browser. PDFs open in Wild OS PDF even though Brave
# also claims them.
[Default Applications]
x-scheme-handler/http=brave-browser.desktop
x-scheme-handler/https=brave-browser.desktop
text/html=brave-browser.desktop
application/xhtml+xml=brave-browser.desktop
x-scheme-handler/about=brave-browser.desktop
x-scheme-handler/unknown=brave-browser.desktop
application/pdf=org.wildos.pdf.desktop

# Songs and playlists open in Wild OS Music.
audio/mpeg=org.wildos.music.desktop
audio/mp3=org.wildos.music.desktop
audio/x-mp3=org.wildos.music.desktop
audio/flac=org.wildos.music.desktop
audio/x-flac=org.wildos.music.desktop
audio/ogg=org.wildos.music.desktop
audio/x-vorbis+ogg=org.wildos.music.desktop
audio/vorbis=org.wildos.music.desktop
audio/x-opus+ogg=org.wildos.music.desktop
audio/opus=org.wildos.music.desktop
audio/mp4=org.wildos.music.desktop
audio/x-m4a=org.wildos.music.desktop
audio/m4a=org.wildos.music.desktop
audio/aac=org.wildos.music.desktop
audio/x-aac=org.wildos.music.desktop
audio/wav=org.wildos.music.desktop
audio/x-wav=org.wildos.music.desktop
audio/vnd.wave=org.wildos.music.desktop
audio/aiff=org.wildos.music.desktop
audio/x-aiff=org.wildos.music.desktop
audio/x-ms-wma=org.wildos.music.desktop
audio/x-ape=org.wildos.music.desktop
audio/x-wavpack=org.wildos.music.desktop
audio/x-musepack=org.wildos.music.desktop
audio/x-mpegurl=org.wildos.music.desktop
audio/mpegurl=org.wildos.music.desktop
application/vnd.apple.mpegurl=org.wildos.music.desktop

# Videos open in Wild OS Videos.
video/mp4=org.wildos.videos.desktop
video/x-m4v=org.wildos.videos.desktop
video/quicktime=org.wildos.videos.desktop
video/x-matroska=org.wildos.videos.desktop
video/webm=org.wildos.videos.desktop
video/x-msvideo=org.wildos.videos.desktop
video/avi=org.wildos.videos.desktop
video/msvideo=org.wildos.videos.desktop
video/x-ms-wmv=org.wildos.videos.desktop
video/x-ms-asf=org.wildos.videos.desktop
video/x-flv=org.wildos.videos.desktop
video/mpeg=org.wildos.videos.desktop
video/x-mpeg=org.wildos.videos.desktop
video/x-mpeg2=org.wildos.videos.desktop
video/mp2t=org.wildos.videos.desktop
video/vnd.mpegurl=org.wildos.videos.desktop
video/3gpp=org.wildos.videos.desktop
video/3gpp2=org.wildos.videos.desktop
video/ogg=org.wildos.videos.desktop
video/x-ogm+ogg=org.wildos.videos.desktop
video/x-theora+ogg=org.wildos.videos.desktop
video/dv=org.wildos.videos.desktop
video/x-matroska-3d=org.wildos.videos.desktop
video/vnd.avi=org.wildos.videos.desktop
video/x-flic=org.wildos.videos.desktop
video/x-nsv=org.wildos.videos.desktop
video/x-anim=org.wildos.videos.desktop
application/x-matroska=org.wildos.videos.desktop

# Archives open in Wild OS Archive.
application/zip=org.wildos.archive.desktop
application/x-zip-compressed=org.wildos.archive.desktop
application/x-7z-compressed=org.wildos.archive.desktop
application/vnd.rar=org.wildos.archive.desktop
application/x-rar=org.wildos.archive.desktop
application/x-rar-compressed=org.wildos.archive.desktop
application/x-tar=org.wildos.archive.desktop
application/x-gtar=org.wildos.archive.desktop
application/x-compressed-tar=org.wildos.archive.desktop
application/x-bzip-compressed-tar=org.wildos.archive.desktop
application/x-bzip2-compressed-tar=org.wildos.archive.desktop
application/x-xz-compressed-tar=org.wildos.archive.desktop
application/x-zstd-compressed-tar=org.wildos.archive.desktop
application/x-lzma-compressed-tar=org.wildos.archive.desktop
application/x-lzip-compressed-tar=org.wildos.archive.desktop
application/x-tarz=org.wildos.archive.desktop
application/gzip=org.wildos.archive.desktop
application/x-gzip=org.wildos.archive.desktop
application/x-bzip=org.wildos.archive.desktop
application/x-bzip2=org.wildos.archive.desktop
application/x-xz=org.wildos.archive.desktop
application/zstd=org.wildos.archive.desktop
application/x-zstd=org.wildos.archive.desktop
application/x-lzma=org.wildos.archive.desktop
application/x-lzip=org.wildos.archive.desktop
application/x-cpio=org.wildos.archive.desktop
application/vnd.ms-cab-compressed=org.wildos.archive.desktop
application/x-lha=org.wildos.archive.desktop

# Email links open in Wild OS Mail.
x-scheme-handler/mailto=org.wildos.mail.desktop

# Folders open in Wild OS Files, links to apps in the Wild OS Store.
inode/directory=org.wildos.files.desktop
x-scheme-handler/appstream=org.wildos.store.desktop

# Package files open on their own install page in the Store, which says
# plainly that nothing has checked them.
application/vnd.debian.binary-package=org.wildos.store.desktop
application/x-deb=org.wildos.store.desktop
application/vnd.flatpak.ref=org.wildos.store.desktop
application/x-flatpak-ref=org.wildos.store.desktop
application/vnd.flatpak=org.wildos.store.desktop
application/x-flatpak=org.wildos.store.desktop

# Windows programs open in the App Bridge, which explains what will happen
# and runs them in a sandbox.
application/x-ms-dos-executable=org.wildos.run.desktop
application/x-msi=org.wildos.run.desktop
application/x-msdownload=org.wildos.run.desktop
application/vnd.microsoft.portable-executable=org.wildos.run.desktop
# Shortcuts Windows apps put on the shared Desktop open in Windows mode.
application/x-ms-shortcut=org.wildos.winmode.shortcut.desktop

# Documents and spreadsheets open in Write and Tables, under LibreOffice's
# launcher ids. Windows mode's "Open Windows files in Windows apps" writes
# its own lines to the person's mimeapps.list, which win over these.
application/vnd.openxmlformats-officedocument.wordprocessingml.document=libreoffice-writer.desktop
application/vnd.openxmlformats-officedocument.wordprocessingml.template=libreoffice-writer.desktop
application/vnd.ms-word.document.macroEnabled.12=libreoffice-writer.desktop
application/vnd.ms-word.template.macroEnabled.12=libreoffice-writer.desktop
application/msword=libreoffice-writer.desktop
application/rtf=libreoffice-writer.desktop
text/rtf=libreoffice-writer.desktop
application/vnd.oasis.opendocument.text=libreoffice-writer.desktop
application/vnd.oasis.opendocument.text-template=libreoffice-writer.desktop
application/vnd.oasis.opendocument.text-flat-xml=libreoffice-writer.desktop
application/vnd.openxmlformats-officedocument.spreadsheetml.sheet=libreoffice-calc.desktop
application/vnd.openxmlformats-officedocument.spreadsheetml.template=libreoffice-calc.desktop
application/vnd.ms-excel.sheet.macroEnabled.12=libreoffice-calc.desktop
application/vnd.ms-excel.template.macroEnabled.12=libreoffice-calc.desktop
application/vnd.ms-excel=libreoffice-calc.desktop
application/vnd.oasis.opendocument.spreadsheet=libreoffice-calc.desktop
application/vnd.oasis.opendocument.spreadsheet-template=libreoffice-calc.desktop
application/vnd.oasis.opendocument.spreadsheet-flat-xml=libreoffice-calc.desktop
text/csv=libreoffice-calc.desktop
