# The Wild OS high contrast scheme (Settings > Accessibility > High
# contrast, Super Alt H), after Windows' Aquatic contrast theme: white text
# on solid black, a bright cyan for selection, focus and links with black
# text on it, and frames drawn at full contrast. Wild OS's own apps draw
# their high contrast look from WildOS.UI's Style, which switches when this
# scheme is applied; this file covers KDE and Qt apps.
#
#   ink #ffffff         ink-muted #c8c8c8     ground #000000
#   accent #75e9fc      on-accent #000000     visited #d6b4fd

[ColorEffects:Disabled]
Color=56,56,56
ColorAmount=0
ColorEffect=0
ContrastAmount=0.45
ContrastEffect=1
IntensityAmount=0
IntensityEffect=0

[ColorEffects:Inactive]
ChangeSelectionColor=false
Color=0,0,0
ColorAmount=0
ColorEffect=0
ContrastAmount=0
ContrastEffect=0
Enable=false
IntensityAmount=0
IntensityEffect=0

