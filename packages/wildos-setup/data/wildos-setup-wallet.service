[Unit]
Description=Open the wallet of the account first boot setup made
# Setup leaves the wallet's salt and no wallet; every later session has both.
ConditionPathExists=%h/.local/share/kwalletd/kdewallet.salt
ConditionPathExists=!%h/.local/share/kwalletd/kdewallet.kwl
PartOf=graphical-session.target
# Where pam_kwallet's own unit opens the wallet, so nothing in the session
# asks for a secret first and gets KWallet's create-a-wallet dialog.
Before=plasma-plasmashell.service plasma-kded6.service xdg-desktop-autostart.target
After=plasma-kwin_wayland.service plasma-kcminit.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/wildos/wildos-setup-wallet
Slice=background.slice
# The desktop waits for this; it must never hold the first sign-in up.
TimeoutStartSec=30
