[Unit]
Description=Open the wallet of an account that signed in without a password
PartOf=graphical-session.target
# Where pam_kwallet's own unit opens the wallet, so nothing in the session
# asks for a secret first and gets KWallet's password prompt. After it, so
# a wallet it opened with the typed password is seen as open.
Before=plasma-plasmashell.service plasma-kded6.service xdg-desktop-autostart.target
After=plasma-kwin_wayland.service plasma-kcminit.service plasma-kwallet-pam.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/wildos/wildos-setup-wallet
Slice=background.slice
# The desktop waits for this; it must never hold the sign-in up.
TimeoutStartSec=30
