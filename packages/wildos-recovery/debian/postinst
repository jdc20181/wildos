#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    systemctl enable wildos-boot-ok.service wildos-restore-points.service \
        wildos-restore-points.timer wildos-reset-copy.timer >/dev/null 2>&1 || true

    # On an installed PC (not the image build, not the live system): the
    # start-up files get the go-back hook, recovery's kernel goes to /boot
    # if the reset copy checks out, and the menu learns start-up recovery.
    if [ -d /run/systemd/system ] && [ ! -e /run/initramfs/live ] \
        && ! systemd-detect-virt --chroot --quiet; then
        if [ -d /var/lib/wildos/reset ]; then
            /usr/libexec/wildos/reset-copy boot-files >/dev/null 2>&1 || true
        fi
        if [ "$(findmnt -no FSTYPE /)" != btrfs ]; then
            dracut --force >/dev/null 2>&1 || echo "wildos-recovery: the start-up files are updated at the next kernel update" >&2
        fi
        if [ -e /boot/grub/grub.cfg ] && command -v update-grub >/dev/null; then
            update-grub >/dev/null 2>&1 || true
        fi
        systemctl daemon-reload >/dev/null 2>&1 || true
        systemctl start wildos-restore-points.service >/dev/null 2>&1 || true
    fi
fi

#DEBHELPER#
