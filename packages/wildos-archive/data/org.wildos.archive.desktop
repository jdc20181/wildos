[Desktop Entry]
Type=Application
Name=Archive
GenericName=Archive manager
Comment=Open, extract and make ZIP and 7z archives
Exec=wildos-archive %F
Icon=wildos-archive
Terminal=false
StartupNotify=true
StartupWMClass=wildos-archive
Categories=Qt;Utility;Archiving;Compression;
MimeType=application/zip;application/x-zip-compressed;application/x-7z-compressed;application/vnd.rar;application/x-rar;application/x-rar-compressed;application/x-tar;application/x-gtar;application/x-compressed-tar;application/x-bzip-compressed-tar;application/x-bzip2-compressed-tar;application/x-xz-compressed-tar;application/x-zstd-compressed-tar;application/x-lzma-compressed-tar;application/x-lzip-compressed-tar;application/x-tarz;application/gzip;application/x-gzip;application/x-bzip;application/x-bzip2;application/x-xz;application/zstd;application/x-zstd;application/x-lzma;application/x-lzip;application/x-cpio;application/vnd.ms-cab-compressed;application/x-lha;
Keywords=archive;zip;unzip;7z;7-zip;rar;tar;gz;tgz;extract;compress;winrar;winzip;
X-DBUS-StartupType=Unique
X-DBUS-ServiceName=org.wildos.archive
