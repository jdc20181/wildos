+// Wild OS: the toolbars holding the window's hamburger menu, which holds
+// the same menus as the menu bar. Its actions live in the window's action
+// collection, which is not a child object of the window.
+static QList<QToolBar *> wildosHamburgerToolBars(KMainWindow *window)
+{
+    QList<KHamburgerMenu *> menus = window->findChildren<KHamburgerMenu *>();
+    if (auto *gui = qobject_cast<KXmlGuiWindow *>(window)) {
+        const auto actions = gui->actionCollection()->actions();
+        for (QAction *action : actions) {
+            if (auto *menu = qobject_cast<KHamburgerMenu *>(action)) {
+                menus << menu;
+            }
+        }
+    }
+    QList<QToolBar *> bars;
+    for (KHamburgerMenu *menu : std::as_const(menus)) {
+        const auto objects = menu->associatedObjects();
+        for (QObject *object : objects) {
+            if (auto *bar = qobject_cast<QToolBar *>(object); bar && !bars.contains(bar)) {
+                bars << bar;
+            }
+        }
+    }
+    return bars;
+}
+
+// Whether a hamburger menu is on screen in a toolbar that shows.
+static bool wildosHamburgerShown(KMainWindow *window)
+{
+    const auto bars = wildosHamburgerToolBars(window);
+    for (QToolBar *bar : bars) {
+        if (!bar->isHidden()) {
+            return true;
+        }
+    }
+    return false;
+}
+
+// Set on a menu bar shown only because no hamburger menu was in sight. Such
+// a menu bar isn't the person's choice: it isn't saved as one, and it goes
+// again once the hamburger's toolbar is back. Without this, hiding the
+// toolbar once brought the stock menu bar back for good.
+static const char wildosFallbackProperty[] = "_wildos_menubar_fallback";
+
+static void wildosShowFallbackMenuBar(QMenuBar *mb)
+{
+    mb->show();
+    mb->setProperty(wildosFallbackProperty, true);
+}
+
+static void wildosFollowHamburgerToolBars(KMainWindow *window, QMenuBar *mb)
+{
+    const auto bars = wildosHamburgerToolBars(window);
+    for (QToolBar *bar : bars) {
+        if (bar->property("_wildos_watched").toBool()) {
+            continue;
+        }
+        bar->setProperty("_wildos_watched", true);
+        QObject::connect(bar, &QToolBar::visibilityChanged, mb, [window, mb] {
+            if (wildosHamburgerShown(window)) {
+                if (mb->property(wildosFallbackProperty).toBool()) {
+                    mb->hide();
+                    mb->setProperty(wildosFallbackProperty, false);
+                }
+            } else if (mb->isHidden()) {
+                wildosShowFallbackMenuBar(mb);
+            }
+        });
+    }
+}
+
+static bool wildosHasHamburger(KMainWindow *window)
+{
+    if (window->findChild<KHamburgerMenu *>()) {
+        return true;
+    }
+    if (auto *gui = qobject_cast<KXmlGuiWindow *>(window)) {
+        const auto actions = gui->actionCollection()->actions();
+        for (QAction *action : actions) {
+            if (qobject_cast<KHamburgerMenu *>(action)) {
+                return true;
+            }
+        }
+    }
+    return false;
+}
