+// Wild OS: every window with a menu bar and a toolbar gets a hamburger menu
+// first on its toolbar, holding the same menus, so the menu bar can stay
+// hidden and the header is one row (see KMainWindow::applyMainWindowSettings).
+// An app's own hamburger menu is used as it is. Called after every rebuild
+// of the window's menus and toolbars, which drops actions added by hand.
+static const QLatin1String wildosMenuName("wildos_hamburger_menu");
+
+static void wildosEnsureHamburger(KXmlGuiWindow *window)
+{
+    QMenuBar *menuBar = window->findChild<QMenuBar *>(QString(), Qt::FindDirectChildrenOnly);
+    if (!menuBar || menuBar->isNativeMenuBar()) {
+        return;
+    }
+    KToolBar *bar = nullptr;
+    const auto bars = window->toolBars();
+    for (KToolBar *candidate : bars) {
+        if (candidate->objectName() == QLatin1String("mainToolBar")) {
+            bar = candidate;
+            break;
+        }
+    }
+    if (!bar && !bars.isEmpty()) {
+        bar = bars.first();
+    }
+    KHamburgerMenu *own = nullptr;
+    KHamburgerMenu *ours = window->findChild<KHamburgerMenu *>(wildosMenuName, Qt::FindDirectChildrenOnly);
+    const auto actions = window->actionCollection()->actions();
+    for (QAction *action : actions) {
+        auto *menu = qobject_cast<KHamburgerMenu *>(action);
+        if (menu && menu != ours) {
+            own = menu;
+            break;
+        }
+    }
+    // A hidden toolbar can't hold the menus.
+    if (bar && (bar->isHidden() || bar->orientation() != Qt::Horizontal)) {
+        bar = nullptr;
+    }
+    // An app's own hamburger menu moves to the same place, first on the main
+    // toolbar, so it is in one place in every app; a toolbar it had to
+    // itself is hidden once empty.
+    if (own && bar && bar->actions().value(0) != own) {
+        for (KToolBar *b : bars) {
+            if (b != bar && b->actions().contains(own)) {
+                b->removeAction(own);
+                if (b->actions().isEmpty()) {
+                    b->hide();
+                }
+            }
+        }
+        bar->removeAction(own);
+        bar->insertAction(bar->actions().value(0), own);
+    }
+    if (own || !bar) {
+        if (ours) {
+            for (KToolBar *b : bars) {
+                b->removeAction(ours);
+            }
+            ours->deleteLater();
+        }
+        return;
+    }
+    if (!ours) {
+        ours = new KHamburgerMenu(window);
+        ours->setObjectName(wildosMenuName);
+        // What KStandardActions gives an app's own hamburger menu.
+        ours->setIcon(QIcon::fromTheme(QStringLiteral("application-menu")));
+        ours->setText(i18nc("@action:inmenu", "Menu"));
+        ours->setMenuBar(menuBar);
+        if (QAction *show = window->actionCollection()->action(KStandardActions::name(KStandardActions::ShowMenubar))) {
+            ours->setShowMenuBarAction(show);
+        }
+    }
+    // First on the toolbar, so a narrow window never pushes it into the
+    // toolbar's overflow menu.
+    if (bar->actions().value(0) != ours) {
+        bar->removeAction(ours);
+        bar->insertAction(bar->actions().value(0), ours);
+    }
+}
