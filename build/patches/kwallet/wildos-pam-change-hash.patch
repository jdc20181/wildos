+++ b/src/runtime/kwalletd/backend/kwalletbackend.h
@@ -86,6 +86,10 @@
     // If opening fails, the password's hash will be cleared.
     int openPreHashed(const QByteArray &passwordHash);

+    // Re-encrypt an open wallet with another pre-hashed password, but only
+    // if it was opened with oldHash. On failure the wallet keeps oldHash.
+    int changePreHashed(const QByteArray &oldHash, const QByteArray &newHash);
+
     // Close the wallet, losing any changes.
     // if save is true, the wallet is saved prior to closing it.
     int close(bool save = false);
diff -ru a/src/runtime/kwalletd/kwalletd.cpp b/src/runtime/kwalletd/kwalletd.cpp
--- a/src/runtime/kwalletd/kwalletd.cpp
+++ b/src/runtime/kwalletd/kwalletd.cpp
@@ -1921,6 +1921,33 @@
     return handle;
 }

+int KWalletD::pamChangeHash(const QString &wallet, const QByteArray &oldHash, const QByteArray &newHash)
+{
+    if (_processing) {
+        return -1;
+    }
+
+    // An open wallet is changed in place, so every app keeps its handle.
+    const QPair<int, KWallet::Backend *> walletInfo = findWallet(wallet);
+    if (walletInfo.second) {
+        return walletInfo.second->changePreHashed(oldHash, newHash);
+    }
+    // openPreHashed would create a missing wallet.
+    if (!wallets().contains(wallet)) {
+        return 1;
+    }
+
+    KWallet::Backend b(wallet);
+    int rc = b.openPreHashed(oldHash);
+    if (rc == 0 && b.isOpen()) {
+        rc = b.changePreHashed(oldHash, newHash);
+    }
+    if (b.isOpen()) {
+        b.close(false);
+    }
+    return rc;
+}
