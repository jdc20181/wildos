+int Backend::changePreHashed(const QByteArray &oldHash, const QByteArray &newHash)
+{
+    if (!_open) {
+        return -255;
+    }
+    if (_cipherType != BACKEND_CIPHER_BLOWFISH || newHash.size() != 56) {
+        return -42; // unsupported encryption scheme
+    }
+    // Opening swaps the modern hash in, so both hold the key in use.
+    if (!_useNewHash || _newPassHash != oldHash) {
+        return -9; // incorrect password
+    }
+
+    _passhash = newHash;
+    _newPassHash = newHash;
+    const int rc = sync(0);
+    if (rc != 0) {
+        _passhash = oldHash;
+        _newPassHash = oldHash;
+    }
+    return rc;
+}
+
 int Backend::openInternal(WId w)
 {
     // No wallet existed.  Let's create it.
diff -ru a/src/runtime/kwalletd/backend/kwalletbackend.h b/src/runtime/kwalletd/backend/kwalletbackend.h
