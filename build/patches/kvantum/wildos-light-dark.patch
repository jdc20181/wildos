+/* Wild OS: which variant of the WildOS theme the colour scheme calls for.
+   It goes by the window colour of the scheme actually applied, the same rule
+   the Wild OS apps use, rather than by the scheme's name: the name is only
+   a label, and a scheme picked elsewhere (Breeze, say) is judged correctly
+   too. */
+static QString wildosSchemeVariant()
+{
+  QString home = QString::fromLocal8Bit(qgetenv("XDG_CONFIG_HOME"));
+  if (home.isEmpty())
+    home = QDir::homePath() + QLatin1String("/.config");
+  QStringList files;
+  files << home + QLatin1String("/kdeglobals");
+  QString dirs = QString::fromLocal8Bit(qgetenv("XDG_CONFIG_DIRS"));
+  if (dirs.isEmpty())
+    dirs = QLatin1String("/etc/xdg");
+  const QStringList dirList = dirs.split(QLatin1Char(':'), Qt::SkipEmptyParts);
+  for (const QString &dir : dirList)
+    files << dir + QLatin1String("/kdeglobals");
+  QString scheme;
+  for (const QString &file : static_cast<const QStringList&>(files))
+  {
+    if (!QFile::exists(file))
+      continue;
+    QSettings globals(file, QSettings::IniFormat);
+    const QColor window = wildosColour(globals.value(QLatin1String("Colors:Window/BackgroundNormal")));
+    if (window.isValid())
+      return window.lightnessF() >= 0.5 ? QStringLiteral("WildOSLight") : QStringLiteral("WildOS");
+    if (scheme.isEmpty())
+      scheme = globals.value(QLatin1String("ColorScheme")).toString();
+  }
+  return scheme.contains(QLatin1String("Light")) ? QStringLiteral("WildOSLight") : QStringLiteral("WildOS");
+}
+
+/* Wild OS: light and dark mode switch at sunrise and sunset with apps open,
+   and the accent can change any time. Kvantum reads its theme once, so the
+   style watches kdeglobals and, when the variant or the accent changes,
+   has the app load the style again, which repaints every window. */
+void Style::wildosFollowScheme()
+{
+  const QString path = xdg_config_home + QLatin1String("/kdeglobals");
+  wildosWatcher_ = new QFileSystemWatcher(this);
+  if (QFile::exists(path))
+    wildosWatcher_->addPath(path);
+  /* The file is often saved by replacing it, which ends the watch on it,
+     so the folder is watched too, for the new file appearing. */
+  wildosWatcher_->addPath(xdg_config_home);
+  auto *settle = new QTimer(this);
+  settle->setSingleShot(true);
+  settle->setInterval(300);
+  auto changed = [this, path, settle] (const QString &which) {
+    if (which == path || which == xdg_config_home)
+      settle->start();
+  };
+  connect(wildosWatcher_, &QFileSystemWatcher::fileChanged, this, changed);
+  connect(wildosWatcher_, &QFileSystemWatcher::directoryChanged, this, changed);
+  connect(settle, &QTimer::timeout, this, [this, path] {
+    if (QFile::exists(path) && !wildosWatcher_->files().contains(path))
+      wildosWatcher_->addPath(path);
+    if (wildosSchemeVariant() == wildosVariant_ && wildosSystemAccent().name() == wildosAccent_)
+      return;
+    /* Not from here: setting a new style deletes this one. */
+    QTimer::singleShot(0, qApp, [] {
+      QApplication::setStyle(QStringLiteral("kvantum"));
+    });
+  });
+}
