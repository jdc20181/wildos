+/* Wild OS: a theme can follow the accent colour picked in the system
+   settings (kdeglobals, [General] AccentColor). Its kvconfig names the
+   colours it draws the accent with in [General] accent_colors: the accent,
+   its hover shade and its pressed shade. Those exact colours are swapped in
+   the SVG before it is loaded. The theme is drawn for the default accent
+   (Glacier, #8fb4ff), so with that accent nothing changes. In a light theme
+   the accent is deepened until white text on it reads, the same rule the
+   Wild OS apps use. */
+static QColor wildosColour(const QVariant &value)
+{
+  const QStringList parts = value.toStringList();
+  if (parts.size() >= 3)
+    return QColor(parts.at(0).trimmed().toInt(), parts.at(1).trimmed().toInt(), parts.at(2).trimmed().toInt());
+  return QColor(value.toString().trimmed());
+}
+
+static QColor wildosSystemAccent()
+{
+  QString home = QString::fromLocal8Bit(qgetenv("XDG_CONFIG_HOME"));
+  if (home.isEmpty())
+    home = QDir::homePath() + QLatin1String("/.config");
+  QStringList files;
+  files << home + QLatin1String("/kdeglobals");
+  QString dirs = QString::fromLocal8Bit(qgetenv("XDG_CONFIG_DIRS"));
+  if (dirs.isEmpty())
+    dirs = QLatin1String("/etc/xdg");
+  const QStringList dirList = dirs.split(QLatin1Char(':'), Qt::SkipEmptyParts);
+  for (const QString &dir : dirList)
+    files << dir + QLatin1String("/kdeglobals");
+  for (const QString &file : static_cast<const QStringList&>(files))
+  {
+    if (!QFile::exists(file))
+      continue;
+    QSettings globals(file, QSettings::IniFormat);
+    const QVariant value = globals.value(QLatin1String("AccentColor"));
+    if (value.isValid())
+      return wildosColour(value);
+  }
+  return QColor();
+}
+
+static qreal wildosLuminance(const QColor &c)
+{
+  auto f = [](qreal v) { return v <= 0.03928 ? v / 12.92 : qPow((v + 0.055) / 1.055, 2.4); };
+  return 0.2126 * f(c.redF()) + 0.7152 * f(c.greenF()) + 0.0722 * f(c.blueF());
+}
+
+static QColor wildosDeepen(const QColor &c, qreal saturation, qreal lightness, qreal contrast)
+{
+  if (c.hslSaturationF() <= 0)
+    return QColor::fromHslF(0, 0, lightness);
+  const qreal hue = qMax(c.hslHueF(), static_cast<qreal>(0));
+  qreal l = lightness;
+  QColor out = QColor::fromHslF(hue, c.hslSaturationF() * saturation, l);
+  while (l > 0.2 && 1.05 / (wildosLuminance(out) + 0.05) < contrast)
+  {
+    l -= 0.01;
+    out = QColor::fromHslF(hue, c.hslSaturationF() * saturation, l);
+  }
+  return out;
+}
+
+static void wildosLoadSvg(QSvgRenderer *renderer, const QString &svgPath)
+{
+  QString config = svgPath;
+  config.replace(config.length() - 4, 4, QLatin1String(".kvconfig"));
+  QFile svgFile(svgPath);
+  if (!QFile::exists(config) || !svgFile.open(QIODevice::ReadOnly))
+  {
+    renderer->load(svgPath);
+    return;
+  }
+  QSettings theme(config, QSettings::IniFormat);
+  const QStringList drawn = theme.value(QLatin1String("General/accent_colors")).toStringList();
+  const QColor accent = wildosSystemAccent();
+  if (drawn.size() != 3 || !accent.isValid() || accent == QColor(0x8f, 0xb4, 0xff))
+  {
+    renderer->load(svgPath);
+    return;
+  }
+  const QColor window(theme.value(QLatin1String("GeneralColors/window.color")).toString());
+  const bool dark = !window.isValid() || window.lightnessF() < 0.5;
+  const QColor base = dark ? accent : wildosDeepen(accent, 0.676, 0.527, 4.5);
+  const QList<QColor> wanted = {base,
+                                dark ? base.lighter(108) : base.darker(108),
+                                dark ? base.darker(108) : base.darker(118)};
+  QString svg = QString::fromUtf8(svgFile.readAll());
+  /* two passes, so a new colour that happens to equal an old one is not
+     swapped twice */
+  for (int i = 0; i < 3; ++i)
+    svg.replace(drawn.at(i).trimmed(), QString(QLatin1String("@wildos-accent-%1@")).arg(i), Qt::CaseInsensitive);
+  for (int i = 0; i < 3; ++i)
+    svg.replace(QString(QLatin1String("@wildos-accent-%1@")).arg(i), wanted.at(i).name(QColor::HexRgb));
+  renderer->load(svg.toUtf8());
+}
