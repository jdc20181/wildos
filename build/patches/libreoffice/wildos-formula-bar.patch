+
+void ScInputBarGroup::Paint(vcl::RenderContext& rRenderContext, const tools::Rectangle& rRect)
+{
+    InterimItemWindow::Paint(rRenderContext, rRect);
+    int x, y, width, height;
+    if (comphelper::LibreOfficeKit::isActive()
+        || !mxBackground->get_extents_relative_to(*m_xContainer, x, y, width, height))
+        return;
+
+    // The formula's field: 5 px corners, its edge in the accent while the
+    // formula is being edited.
+    const StyleSettings& rStyleSettings = rRenderContext.GetSettings().GetStyleSettings();
+    Color aEdge(ScWildOSBarColor(rStyleSettings));
+    aEdge.Merge(rStyleSettings.GetDialogTextColor(), 235);
+    if (HasChildPathFocus())
+        aEdge = rStyleSettings.GetAccentColor();
+    tools::Rectangle aField(Point(x - 5, y - 2), Size(width + 10, height + 4));
+    rRenderContext.Push(vcl::PushFlags::LINECOLOR | vcl::PushFlags::FILLCOLOR);
+    rRenderContext.SetAntialiasing(rRenderContext.GetAntialiasing() | AntialiasingFlags::Enable);
+    rRenderContext.SetLineColor();
+    rRenderContext.SetFillColor(aEdge);
+    rRenderContext.DrawRect(aField, 5, 5);
+    aField.shrink(1);
+    rRenderContext.SetFillColor(ScWildOSFieldColor(rStyleSettings));
+    rRenderContext.DrawRect(aField, 4, 4);
+    rRenderContext.Pop();
+}
+
+bool ScInputBarGroup::EventNotify(NotifyEvent& rNEvt)
+{
+    if (rNEvt.GetType() == NotifyEventType::GETFOCUS || rNEvt.GetType() == NotifyEventType::LOSEFOCUS)
+        Invalidate(InvalidateFlags::NoChildren);
+    return InterimItemWindow::EventNotify(rNEvt);
 }
 
