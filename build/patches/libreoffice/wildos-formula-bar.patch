+// Wild OS: the formula bar is drawn on the window colour of the docking
+// area it sits in, the formula in a rounded field a shade into the ink.
+static Color ScWildOSBarColor(const StyleSettings& rStyle)
+{
+    return rStyle.GetDialogColor();
+}
+
+static Color ScWildOSFieldColor(const StyleSettings& rStyle)
+{
+    Color aColor(ScWildOSBarColor(rStyle));
+    aColor.Merge(rStyle.GetDialogTextColor(), 242);
+    return aColor;
+}
