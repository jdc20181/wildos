+void NotebookbarTabControlBase::Paint(vcl::RenderContext& rRenderContext, const tools::Rectangle& rRect)
+{
+    if (!m_bWildOS)
+        return TabControl::Paint(rRenderContext, rRect);
+
+    HideFocus();
+    // Lays the tabs out first if they need it.
+    ImplGetTabRect(TAB_PAGERECT);
+
+    const StyleSettings& rStyle = rRenderContext.GetSettings().GetStyleSettings();
+    const Color& rWindow = rStyle.GetDialogColor();
+    const Color& rInk = rStyle.GetDialogTextColor();
+    const Color& rAccent = rStyle.GetAccentColor();
+    const Size aSize(GetOutputSizePixel());
+
+    rRenderContext.Push(vcl::PushFlags::LINECOLOR | vcl::PushFlags::FILLCOLOR
+                        | vcl::PushFlags::FONT | vcl::PushFlags::TEXTCOLOR);
+    rRenderContext.SetAntialiasing(rRenderContext.GetAntialiasing() | AntialiasingFlags::Enable);
+    rRenderContext.SetLineColor();
+    rRenderContext.SetFillColor(lcl_wildosRowColor(rStyle));
+    rRenderContext.DrawRect(tools::Rectangle(Point(0, 0), Size(aSize.Width(), WILDOS_ROW_HEIGHT)));
+    rRenderContext.SetFillColor(rWindow);
+    rRenderContext.DrawRect(tools::Rectangle(
+        Point(0, WILDOS_ROW_HEIGHT), Size(aSize.Width(), aSize.Height() - WILDOS_ROW_HEIGHT)));
+    rRenderContext.SetFillColor(lcl_mix(rWindow, rInk, 0.08));
+    rRenderContext.DrawRect(tools::Rectangle(Point(0, aSize.Height() - 1), Size(aSize.Width(), 1)));
+    if (TabPage* pPage = GetTabPage(mnCurPageId))
+        lcl_wildosDividers(*this, pPage, rRenderContext, WILDOS_ROW_HEIGHT, aSize.Height() - 6);
+
+    const Point aPointer(GetPointerPosPixel());
+    for (const auto& item : mpTabCtrlData->maItemList)
+    {
+        if (!item.m_bVisible || item.maRect.IsEmpty())
+            continue;
+        const bool bCurrent = item.id() == mnCurPageId;
+        const bool bHover = IsMouseOver() && item.maRect.Contains(aPointer);
+
+        vcl::Font aFont(GetFont());
+        aFont.SetWeight(bCurrent ? WEIGHT_SEMIBOLD : WEIGHT_NORMAL);
+        aFont.SetTransparent(true);
+        rRenderContext.SetFont(aFont);
+        Color aText = (bCurrent || bHover) ? rInk : lcl_mix(rWindow, rInk, 0.62);
+        if (!item.m_bEnabled || !IsEnabled())
+            aText = lcl_mix(rWindow, rInk, 0.35);
+        rRenderContext.SetTextColor(aText);
+        rRenderContext.DrawText(item.maRect, item.maFormatText,
+                                DrawTextFlags::Center | DrawTextFlags::VCenter
+                                    | DrawTextFlags::Mnemonic);
+
+        if (!bCurrent)
+            continue;
+
+        const tools::Long nTextWidth = rRenderContext.GetCtrlTextWidth(item.maFormatText);
+        rRenderContext.SetFillColor(rAccent);
+        rRenderContext.DrawRect(
+            tools::Rectangle(Point(item.maRect.Left() + (item.maRect.GetWidth() - nTextWidth) / 2,
+                                   item.maRect.Bottom() + 1 - WILDOS_UNDERLINE_GAP - WILDOS_UNDERLINE),
+                             Size(nTextWidth, WILDOS_UNDERLINE)),
+            1, 1);
+
+        if (HasFocus())
+        {
+            rRenderContext.SetFillColor();
+            rRenderContext.SetLineColor(rAccent);
+            tools::Rectangle aRing(item.maRect);
+            aRing.shrink(2);
+            rRenderContext.DrawRect(aRing, 5, 5);
+            aRing.shrink(1);
+            rRenderContext.DrawRect(aRing, 4, 4);
+            rRenderContext.SetLineColor();
+        }
+    }
+    rRenderContext.Pop();
+    mbSmallInvalidate = true;
 }
 
