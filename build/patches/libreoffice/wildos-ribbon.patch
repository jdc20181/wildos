+// The ribbon is built before its window's view frame is current, so the
+// frame is looked up when File or the search field is used: the window
+// they are in is the active one then.
+css::uno::Reference<css::frame::XFrame> NotebookbarTabControl::GetWildOSFrame() const
+{
+    if (SfxViewFrame* pViewFrm = SfxViewFrame::Current())
+        return pViewFrm->GetFrame().GetFrameInterface();
+    return m_xFrame;
+}
+
+IMPL_LINK(NotebookbarTabControl, OpenWildOSFileMenu, vcl::Window&, rButton, void)
+{
+    const Reference<XFrame> xFrame(GetWildOSFrame());
+    if (!xFrame.is())
+        return;
+
+    Sequence<Any> aArgs {
+        Any(comphelper::makePropertyValue(u"Value"_ustr, GetWildOSFileMenu())),
+        Any(comphelper::makePropertyValue(u"Frame"_ustr, xFrame)) };
+
+    const Reference<XComponentContext>& xContext = comphelper::getProcessComponentContext();
+    Reference<XPopupMenuController> xPopupController(
+        xContext->getServiceManager()->createInstanceWithArgumentsAndContext(
+        u"com.sun.star.comp.framework.ResourceMenuController"_ustr, aArgs, xContext), UNO_QUERY);
+    if (!xPopupController.is())
+        return;
+
+    rtl::Reference<VCLXPopupMenu> xPopupMenu = new VCLXPopupMenu();
+    xPopupController->setPopupMenu(xPopupMenu);
+    // Under the button, 4 px down, lined up with its left edge.
+    xPopupMenu->execute(rButton.GetComponentInterface(),
+                        css::awt::Rectangle(0, rButton.GetSizePixel().Height() + 4, 1, 1),
+                        css::awt::PopupMenuDirection::EXECUTE_DOWN);
+
+    Reference<css::lang::XComponent> xComponent(xPopupController, UNO_QUERY);
+    if (xComponent.is())
+        xComponent->dispose();
+}
+
+IMPL_LINK(NotebookbarTabControl, OpenWildOSSearch, vcl::Window&, rField, void)
+{
+    const Reference<XFrame> xFrame(GetWildOSFrame());
+    if (!xFrame.is())
+        return;
+    tools::Rectangle aRect(Point(0, 0), rField.GetSizePixel());
+    weld::Window* pParent = weld::GetPopupParent(rField, aRect);
+    if (!m_pCommandPopup)
+        m_pCommandPopup.reset(new CommandPopupHandler);
+    m_pCommandPopup->showPopup(pParent, xFrame, aRect);
+}
