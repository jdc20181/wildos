+namespace
+{
+// Wild OS ribbon metrics, from the design boards: 12 px at either end of
+// the row, 8 px after the File button, tabs 36 px high with 10 px either
+// side of the label, a 2 px underline 3 px above the foot of the tab, and
+// File and the search field 28 px high.
+constexpr tools::Long WILDOS_ROW_PADDING = 12;
+constexpr tools::Long WILDOS_START_GAP = 8;
+constexpr tools::Long WILDOS_TAB_HEIGHT = 36;
+constexpr tools::Long WILDOS_TAB_PADDING = 10;
+constexpr tools::Long WILDOS_UNDERLINE = 2;
+constexpr tools::Long WILDOS_UNDERLINE_GAP = 3;
+constexpr tools::Long WILDOS_FIELD_HEIGHT = 28;
+constexpr tools::Long WILDOS_SEARCH_WIDTH = 220;
+
+// a with the fraction f of b mixed in.
+Color lcl_mix(const Color& a, const Color& b, double f)
+{
+    Color aColor(a);
+    aColor.Merge(b, sal_uInt8(std::clamp(255.0 * (1.0 - f), 0.0, 255.0)));
+    return aColor;
+}
+
+// The tab row sits a shade below the band in dark mode and a shade into
+// the ink in light mode.
+Color lcl_wildosRowColor(const StyleSettings& rStyle)
+{
+    const Color& rWindow = rStyle.GetDialogColor();
+    return rWindow.IsDark() ? lcl_mix(rWindow, COL_BLACK, 0.2)
+                            : lcl_mix(rWindow, rStyle.GetDialogTextColor(), 0.035);
+}
+
+// File and the search field draw themselves to the boards rather than as
+// native buttons; both stay push buttons for the keyboard and for screen
+// readers.
+class WildOSRowButton : public PushButton
+{
+public:
+    explicit WildOSRowButton(vcl::Window* pParent)
+        : PushButton(pParent, WB_TABSTOP)
+    {
+        SetPaintTransparent(true);
+    }
+
+    virtual void MouseMove(const MouseEvent& rMEvt) override
+    {
+        PushButton::MouseMove(rMEvt);
+        if (rMEvt.IsEnterWindow() || rMEvt.IsLeaveWindow())
+            Invalidate();
+    }
+
+    virtual void GetFocus() override
+    {
+        PushButton::GetFocus();
+        Invalidate();
+    }
+
+    virtual void LoseFocus() override
+    {
+        PushButton::LoseFocus();
+        Invalidate();
+    }
+
+protected:
+    bool IsDown() const { return IsPressed() || (GetButtonState() & DrawButtonFlags::Pressed); }
+
+    vcl::Font LabelFont(double fScale, FontWeight eWeight) const
+    {
+        // The tab labels' font, so File reads at the size of the tabs.
+        vcl::Font aFont(GetSettings().GetStyleSettings().GetTabFont());
+        aFont.SetFontHeight(aFont.GetFontHeight() * fScale);
+        aFont.SetWeight(eWeight);
+        aFont.SetTransparent(true);
+        return aFont;
+    }
+
+    void DrawFocusRing(vcl::RenderContext& rRenderContext, const Color& rColor)
+    {
+        if (!HasFocus())
+            return;
+        tools::Rectangle aRing(Point(0, 0), GetOutputSizePixel());
+        aRing.shrink(2);
+        rRenderContext.SetFillColor();
+        rRenderContext.SetLineColor(rColor);
+        rRenderContext.DrawRect(aRing, 4, 4);
+        rRenderContext.SetLineColor();
+    }
+
+    void Begin(vcl::RenderContext& rRenderContext)
+    {
+        rRenderContext.Push(vcl::PushFlags::LINECOLOR | vcl::PushFlags::FILLCOLOR
+                            | vcl::PushFlags::FONT | vcl::PushFlags::TEXTCOLOR);
+        rRenderContext.SetAntialiasing(rRenderContext.GetAntialiasing() | AntialiasingFlags::Enable);
+        rRenderContext.SetLineColor();
+    }
+};
+
+// File: an accent pill, its label semibold.
+class WildOSFileButton final : public WildOSRowButton
+{
+public:
+    explicit WildOSFileButton(vcl::Window* pParent)
+        : WildOSRowButton(pParent)
+    {
+    }
+
+    virtual Size GetOptimalSize() const override
+    {
+        OutputDevice* pDev = const_cast<WildOSFileButton*>(this)->GetOutDev();
+        pDev->Push(vcl::PushFlags::FONT);
+        pDev->SetFont(LabelFont(1.0, WEIGHT_SEMIBOLD));
+        const tools::Long nWidth = pDev->GetCtrlTextWidth(GetText()) + 24;
+        pDev->Pop();
+        return Size(nWidth, WILDOS_FIELD_HEIGHT);
+    }
+
+    virtual void Paint(vcl::RenderContext& rRenderContext, const tools::Rectangle&) override
+    {
+        const StyleSettings& rStyle = rRenderContext.GetSettings().GetStyleSettings();
+        const Color& rAccent = rStyle.GetAccentColor();
+        const Color& rWindow = rStyle.GetDialogColor();
+        const Color aOnAccent = rAccent.IsDark() ? COL_WHITE
+                                : rWindow.IsDark() ? lcl_mix(rWindow, COL_BLACK, 0.2)
+                                : COL_BLACK;
+        // Hover and press move the accent away from the window colour.
+        const double fShift = IsDown() ? 0.16 : (IsMouseOver() ? 0.08 : 0.0);
+
+        Begin(rRenderContext);
+        const tools::Rectangle aRect(Point(0, 0), GetOutputSizePixel());
+        rRenderContext.SetFillColor(lcl_mix(rAccent, rWindow.IsDark() ? COL_WHITE : COL_BLACK, fShift));
+        rRenderContext.DrawRect(aRect, 6, 6);
+        rRenderContext.SetFont(LabelFont(1.0, WEIGHT_SEMIBOLD));
+        rRenderContext.SetTextColor(aOnAccent);
+        rRenderContext.DrawText(aRect, GetText(),
+                                DrawTextFlags::Center | DrawTextFlags::VCenter
+                                    | DrawTextFlags::Mnemonic);
+        DrawFocusRing(rRenderContext, aOnAccent);
+        rRenderContext.Pop();
+    }
+};
+
+// Find a command: a rounded field with a magnifier and the label as its
+// placeholder.
+class WildOSSearchField final : public WildOSRowButton
+{
+public:
+    explicit WildOSSearchField(vcl::Window* pParent)
+        : WildOSRowButton(pParent)
+    {
+    }
+
+    virtual Size GetOptimalSize() const override
+    {
+        return Size(WILDOS_SEARCH_WIDTH, WILDOS_FIELD_HEIGHT);
+    }
+
+    virtual void Paint(vcl::RenderContext& rRenderContext, const tools::Rectangle&) override
+    {
+        const StyleSettings& rStyle = rRenderContext.GetSettings().GetStyleSettings();
+        const Color aRow = lcl_wildosRowColor(rStyle);
+        const Color& rInk = rStyle.GetDialogTextColor();
+        const Color aQuiet = lcl_mix(aRow, rInk, 0.62);
+        const double fFill = IsDown() ? 0.12 : (IsMouseOver() ? 0.09 : 0.06);
+
+        Begin(rRenderContext);
+        const Size aSize(GetOutputSizePixel());
+        rRenderContext.SetFillColor(lcl_mix(aRow, rInk, fFill));
+        rRenderContext.DrawRect(tools::Rectangle(Point(0, 0), aSize), 6, 6);
+
+        // A 13 px magnifier, 10 px in.
+        const double fX = 15.5, fY = aSize.Height() / 2.0 - 1.0;
+        rRenderContext.SetLineColor(aQuiet);
+        rRenderContext.SetFillColor();
+        rRenderContext.DrawPolyLine(
+            basegfx::utils::createPolygonFromCircle(basegfx::B2DPoint(fX, fY), 4.5), 1.4);
+        basegfx::B2DPolygon aHandle;
+        aHandle.append(basegfx::B2DPoint(fX + 3.4, fY + 3.4));
+        aHandle.append(basegfx::B2DPoint(fX + 6.5, fY + 6.5));
+        rRenderContext.DrawPolyLine(aHandle, 1.4);
+
+        rRenderContext.SetFont(LabelFont(0.94, WEIGHT_NORMAL));
+        rRenderContext.SetTextColor(aQuiet);
+        rRenderContext.DrawText(
+            tools::Rectangle(Point(31, 0), Size(aSize.Width() - 41, aSize.Height())), GetText(),
+            DrawTextFlags::Left | DrawTextFlags::VCenter | DrawTextFlags::EndEllipsis);
+        DrawFocusRing(rRenderContext, rStyle.GetAccentColor());
+        rRenderContext.Pop();
+    }
+};
+}
+
+void NotebookbarTabControlBase::ImplWildOSEnable()
+{
+    if (m_bWildOS)
+        return;
+    m_bWildOS = true;
+    // The search field takes the menu button's place.
+    m_pOpenMenu->Hide();
+}
+
+bool NotebookbarTabControlBase::set_property(const OUString& rKey, const OUString& rValue)
+{
+    if (rKey == "wildos-file-label")
+    {
+        ImplWildOSEnable();
+        if (!m_pWildOSFile)
+        {
+            m_pWildOSFile = VclPtr<WildOSFileButton>::Create(this);
+            m_pWildOSFile->SetClickHdl(LINK(this, NotebookbarTabControlBase, WildOSFileClick));
+            m_pWildOSFile->Show();
+        }
+        m_pWildOSFile->SetText(rValue);
+    }
+    else if (rKey == "wildos-file-menu")
+    {
+        ImplWildOSEnable();
+        m_aWildOSFileMenu = rValue;
+    }
+    else if (rKey == "wildos-search-label")
+    {
+        ImplWildOSEnable();
+        if (!m_pWildOSSearch)
+        {
+            m_pWildOSSearch = VclPtr<WildOSSearchField>::Create(this);
+            m_pWildOSSearch->SetClickHdl(LINK(this, NotebookbarTabControlBase, WildOSSearchClick));
+            m_pWildOSSearch->Show();
+        }
+        m_pWildOSSearch->SetText(rValue);
+        m_pWildOSSearch->SetAccessibleName(rValue);
+    }
+    else
+        return TabControl::set_property(rKey, rValue);
+
+    mbFormat = true;
+    return true;
+}
+
+namespace
+{
+void lcl_wildosStyleLabels(vcl::Window* pParent, const Color& rColor)
+{
+    for (vcl::Window* pChild = pParent->GetWindow(GetWindowType::FirstChild); pChild;
+         pChild = pChild->GetWindow(GetWindowType::Next))
+    {
+        if (pChild->GetType() == WindowType::FIXEDTEXT)
+        {
+            pChild->SetControlForeground(rColor);
+            pChild->Invalidate();
+        }
+        else
+            lcl_wildosStyleLabels(pChild, rColor);
+    }
+}
+
+// The groups of the flat ribbon are its prioritised boxes; a hairline
+// follows each one.
+void lcl_wildosDividers(const vcl::Window& rTabControl, vcl::Window* pParent,
+                        vcl::RenderContext& rRenderContext, tools::Long nTop, tools::Long nBottom)
+{
+    for (vcl::Window* pChild = pParent->GetWindow(GetWindowType::FirstChild); pChild;
+         pChild = pChild->GetWindow(GetWindowType::Next))
+    {
+        if (!pChild->IsVisible())
+            continue;
+        if (dynamic_cast<vcl::IPrioritable*>(pChild))
+        {
+            const tools::Rectangle aGroup(pChild->GetWindowExtentsRelative(rTabControl));
+            rRenderContext.DrawRect(tools::Rectangle(Point(aGroup.Right(), nTop),
+                                                     Point(aGroup.Right(), nBottom)));
+        }
+        else
+            lcl_wildosDividers(rTabControl, pChild, rRenderContext, nTop, nBottom);
+    }
+}
+}
+
+// Group labels are quiet, at 40% of the ink, as on the boards.
+void NotebookbarTabControlBase::ImplWildOSStyleLabels()
+{
+    const StyleSettings& rStyle = GetSettings().GetStyleSettings();
+    lcl_wildosStyleLabels(this, lcl_mix(rStyle.GetDialogColor(), rStyle.GetDialogTextColor(), 0.40));
+}
+
+void NotebookbarTabControlBase::StateChanged(StateChangedType nType)
+{
+    TabControl::StateChanged(nType);
+    if (m_bWildOS && nType == StateChangedType::InitShow)
+        ImplWildOSStyleLabels();
+}
+
+void NotebookbarTabControlBase::DataChanged(const DataChangedEvent& rDCEvt)
+{
+    TabControl::DataChanged(rDCEvt);
+    if (m_bWildOS && rDCEvt.GetType() == DataChangedEventType::SETTINGS
+        && (rDCEvt.GetFlags() & AllSettingsFlags::STYLE))
+        ImplWildOSStyleLabels();
+}
+
+IMPL_LINK_NOARG(NotebookbarTabControlBase, WildOSFileClick, Button*, void)
+{
+    // Pressed while its menu is open.
+    VclPtr<PushButton> xFile(m_pWildOSFile);
+    xFile->SetPressed(true);
+    m_aWildOSFileHdl.Call(*xFile);
+    if (!xFile->isDisposed())
+        xFile->SetPressed(false);
+}
+
+IMPL_LINK_NOARG(NotebookbarTabControlBase, WildOSSearchClick, Button*, void)
+{
+    m_aWildOSSearchHdl.Call(*m_pWildOSSearch);
+}
+
 bool NotebookbarTabControlBase::ImplPlaceTabs( tools::Long nWidth )
 {
     if ( nWidth <= 0 )
         return false;
     if ( mpTabCtrlData->maItemList.empty() )
         return false;
+
+    if (m_bWildOS)
+    {
+        if (m_pShortcuts)
+            m_pShortcuts->Hide();
+        tools::Long nX = WILDOS_ROW_PADDING;
+        if (m_pWildOSFile)
+        {
+            const Size aSize(m_pWildOSFile->GetOptimalSize());
+            m_pWildOSFile->SetPosSizePixel(Point(nX, (WILDOS_ROW_HEIGHT - aSize.Height()) / 2),
+                                           aSize);
+            nX += aSize.Width() + WILDOS_START_GAP;
+        }
+
+        // Measured in the current tab's weight for every tab, so the row
+        // does not shift when another tab is picked.
+        vcl::Font aFont(GetFont());
+        aFont.SetWeight(WEIGHT_SEMIBOLD);
+        GetOutDev()->Push(vcl::PushFlags::FONT);
+        GetOutDev()->SetFont(aFont);
+        for (auto& item : mpTabCtrlData->maItemList)
+        {
+            item.maFormatText = item.maText;
+            item.mnLine = 0;
+            item.mbFullVisible = item.m_bVisible;
+            if (!item.m_bVisible)
+                continue;
+            const tools::Long nTabWidth
+                = GetOutDev()->GetCtrlTextWidth(item.maFormatText) + 2 * WILDOS_TAB_PADDING;
+            tools::Rectangle aNewRect(Point(nX, (WILDOS_ROW_HEIGHT - WILDOS_TAB_HEIGHT) / 2),
+                                      Size(nTabWidth, WILDOS_TAB_HEIGHT));
+            if (mbSmallInvalidate && item.maRect != aNewRect)
+                mbSmallInvalidate = false;
+            item.maRect = aNewRect;
+            nX += nTabWidth;
+        }
+        GetOutDev()->Pop();
+
+        if (m_pWildOSSearch)
+        {
+            const Size aSize(m_pWildOSSearch->GetOptimalSize());
+            m_pWildOSSearch->SetPosSizePixel(Point(nWidth - WILDOS_ROW_PADDING - aSize.Width(),
+                                                   (WILDOS_ROW_HEIGHT - aSize.Height()) / 2),
+                                             aSize);
+            // In a narrow window the field gives way to the tabs.
+            m_pWildOSSearch->Show(nWidth - WILDOS_ROW_PADDING - aSize.Width() >= nX + WILDOS_START_GAP);
+        }
+        return true;
+    }
+
     if (!m_pOpenMenu || m_pOpenMenu->isDisposed())
         return false;
 
@@ -2390,7 +2772,88 @@
 
 Size NotebookbarTabControlBase::calculateRequisition() const
 {
-    return TabControl::ImplCalculateRequisition(m_nHeaderHeight);
+    Size aSize = TabControl::ImplCalculateRequisition(m_nHeaderHeight);
+    // The flat page sits straight under the row with a hairline below it,
+    // not inset in a tab pane's frame.
+    if (m_bWildOS)
+        aSize.AdjustHeight(WILDOS_ROW_HEIGHT + 1 - (m_nHeaderHeight + TAB_OFFSET * 2));
+    return aSize;
+}
