+// A tree list box always paints the field colour; the cards sit on the
+// ribbon's own colour instead.
+void StylesPreviewWindow_Impl::ApplyCardsBackground()
+{
+    vcl::Window* pView = m_bCards ? lcl_findTreeListBox(this) : nullptr;
+    if (!pView)
+        return;
+    AllSettings aSettings(pView->GetSettings());
+    StyleSettings aStyle(aSettings.GetStyleSettings());
+    aStyle.SetFieldColor(GetSettings().GetStyleSettings().GetDialogColor());
+    aSettings.SetStyleSettings(aStyle);
+    pView->SetSettings(aSettings);
+}
+
+void StylesPreviewWindow_Impl::DataChanged(const DataChangedEvent& rDCEvt)
+{
+    InterimItemWindow::DataChanged(rDCEvt);
+    if (rDCEvt.GetType() == DataChangedEventType::SETTINGS
+        && (rDCEvt.GetFlags() & AllSettingsFlags::STYLE))
+        ApplyCardsBackground();
+}
