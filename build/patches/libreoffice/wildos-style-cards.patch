+// In English the cards use the boards' names, in sentence case and short;
+// other languages keep LibreOffice's translated style names.
+static OUString lcl_cardLabel(const std::pair<OUString, OUString>& rStyle)
+{
+    if (Application::GetSettings().GetUILanguageTag().getLanguage() == "en")
+    {
+        if (rStyle.first == "Text body")
+            return u"Body text"_ustr;
+        if (rStyle.first == "Quotations")
+            return u"Quote"_ustr;
+    }
+    return rStyle.second;
+}
+
+void StyleItemController::PaintCard(vcl::RenderContext& rRenderContext, bool bCurrent)
+{
+    SfxObjectShell* pShell = SfxObjectShell::Current();
+    SfxStyleSheetBasePool* pPool = pShell ? pShell->GetStyleSheetPool() : nullptr;
+    SfxStyleSheetBase* pStyle = pPool ? pPool->First(m_eStyleFamily) : nullptr;
+    while (pStyle && pStyle->GetName() != m_aStyleName.first
+           && pStyle->GetName() != m_aStyleName.second)
+        pStyle = pPool->Next();
+
+    // The card is paper: white with dark ink in light and dark mode alike.
+    const Color aPaper(COL_WHITE);
+    const Color aInk(0x1f, 0x26, 0x33);
+    const Color aQuiet(0x5a, 0x62, 0x74);
+    const StyleSettings& rSettings = Application::GetSettings().GetStyleSettings();
+
+    rRenderContext.Push(vcl::PushFlags::LINECOLOR | vcl::PushFlags::FILLCOLOR
+                        | vcl::PushFlags::FONT | vcl::PushFlags::TEXTCOLOR);
+    rRenderContext.SetAntialiasing(rRenderContext.GetAntialiasing() | AntialiasingFlags::Enable);
+    const tools::Rectangle aCard(Point(0, 0), Size(CARD_WIDTH, CARD_HEIGHT));
+    rRenderContext.SetLineColor();
+    if (bCurrent)
+    {
+        rRenderContext.SetFillColor(rSettings.GetAccentColor());
+        rRenderContext.DrawRect(aCard, 5, 5);
+        rRenderContext.SetFillColor(aPaper);
+        rRenderContext.DrawRect(tools::Rectangle(Point(2, 2), Size(CARD_WIDTH - 4, CARD_HEIGHT - 4)), 3, 3);
+    }
+    else
+    {
+        Color aEdge(aPaper);
+        aEdge.Merge(COL_BLACK, 230);
+        rRenderContext.SetFillColor(aEdge);
+        rRenderContext.DrawRect(aCard, 5, 5);
+        rRenderContext.SetFillColor(aPaper);
+        rRenderContext.DrawRect(tools::Rectangle(Point(1, 1), Size(CARD_WIDTH - 2, CARD_HEIGHT - 2)), 4, 4);
+    }
+
+    // "Aa" in the style's font, colour, weight and slant, its size kept
+    // between 12 and 18 px so every card reads at a glance.
+    std::optional<SfxItemSet> const pItemSet(pStyle ? pStyle->GetItemSetForPreview()
+                                                    : std::optional<SfxItemSet>());
+    SvxFont aSample(rRenderContext.GetFont());
+    Color aSampleColor = aInk;
+    if (pItemSet)
+    {
+        const SvxFontItem* pFontItem = pItemSet->GetItem<SvxFontItem>(SID_ATTR_CHAR_FONT);
+        const SvxFontHeightItem* pHeightItem
+            = pItemSet->GetItem<SvxFontHeightItem>(SID_ATTR_CHAR_FONTHEIGHT);
+        if (pFontItem && pHeightItem)
+        {
+            Size aPixel(rRenderContext.LogicToPixel(Size(0, pHeightItem->GetHeight()),
+                                                    MapMode(pShell->GetMapUnit())));
+            aPixel.setHeight(std::clamp<tools::Long>(aPixel.Height(), 12, 18));
+            aSample = GetFontFromItems(pFontItem, aPixel, pItemSet);
+            aSample.SetUnderline(LINESTYLE_NONE);
+            aSample.SetStrikeout(STRIKEOUT_NONE);
+            aSample.SetCaseMap(SvxCaseMap::NotMapped);
+        }
+        const Color aStyleColor = GetTextColorFromItemSet(pItemSet);
+        if (aStyleColor != COL_AUTO)
+            aSampleColor = aStyleColor;
+    }
+    aSample.SetAlignment(ALIGN_TOP);
+    aSample.SetTransparent(true);
+    rRenderContext.SetFont(aSample);
+    rRenderContext.SetTextColor(aSampleColor);
+    rRenderContext.DrawText(Point(8, 6), u"Aa"_ustr);
+
+    vcl::Font aLabel(rSettings.GetAppFont());
+    aLabel.SetFontSize(Size(0, 11));
+    aLabel.SetWeight(WEIGHT_NORMAL);
+    aLabel.SetItalic(ITALIC_NONE);
+    aLabel.SetAlignment(ALIGN_TOP);
+    aLabel.SetTransparent(true);
+    rRenderContext.SetFont(aLabel);
+    rRenderContext.SetTextColor(aQuiet);
+    rRenderContext.DrawText(
+        tools::Rectangle(Point(8, CARD_HEIGHT - 6 - rRenderContext.GetTextHeight()),
+                         Size(CARD_WIDTH - 14, rRenderContext.GetTextHeight())),
+        lcl_cardLabel(m_aStyleName), DrawTextFlags::Left | DrawTextFlags::EndEllipsis);
+    rRenderContext.Pop();
+}
+
+VclPtr<VirtualDevice> StylesPreviewWindow_Base::GetCard(const std::pair<OUString, OUString>& rStyle,
+                                                        bool bCurrent)
+{
+    // Kept apart from the plain previews of the same style in the cache.
+    const OUString aKey = rStyle.second + (bCurrent ? u"#wildos-current-card"_ustr : u"#wildos-card"_ustr);
+    auto aFound = StylePreviewCache::Get().find(aKey);
+    if (aFound != StylePreviewCache::Get().end())
+        return aFound->second;
+
+    VclPtr<VirtualDevice> pImg = VclPtr<VirtualDevice>::Create(DeviceFormat::WITH_ALPHA);
+    pImg->SetOutputSizePixel(Size(StyleItemController::CARD_WIDTH, StyleItemController::CARD_HEIGHT));
+    pImg->SetBackground(Wallpaper(COL_TRANSPARENT));
+    pImg->Erase();
+    StyleItemController aStyleController(rStyle);
+    aStyleController.PaintCard(*pImg, bCurrent);
+    StylePreviewCache::Get()[aKey] = pImg;
+    return pImg;
+}
+
+IMPL_LINK(StylesPreviewWindow_Base, CardTooltip, const weld::TreeIter&, rIter, OUString)
+{
+    const OUString sId(m_xStylesView->get_id(rIter));
+    for (const auto& rStyle : m_aAllStyles)
+        if (rStyle.first == sId)
+            return lcl_cardLabel(rStyle);
+    return OUString();
+}
