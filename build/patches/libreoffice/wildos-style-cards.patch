+static vcl::Window* lcl_findTreeListBox(vcl::Window* pParent)
+{
+    for (vcl::Window* pChild = pParent->GetWindow(GetWindowType::FirstChild); pChild;
+         pChild = pChild->GetWindow(GetWindowType::Next))
+    {
+        if (pChild->GetType() == WindowType::TREELISTBOX)
+            return pChild;
+        if (vcl::Window* pFound = lcl_findTreeListBox(pChild))
+            return pFound;
+    }
+    return nullptr;
+}
