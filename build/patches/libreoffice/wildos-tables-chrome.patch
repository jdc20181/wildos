+    // Wild OS sheet tabs, 26 px high, corners of 5 px.
+    void drawWildOSTab(const Color& rBar, const Color& rInk, const Color& rAccent)
+    {
+        tools::Rectangle aPill(maRect);
+        const tools::Long nInset = std::max<tools::Long>(0, (aPill.GetHeight() - 26) / 2);
+        aPill.AdjustTop(nInset);
+        aPill.AdjustBottom(-nInset);
+        mrRenderContext.SetLineColor();
+        if (mbSelected || mbCustomColored)
+        {
+            Color aFill(mbCustomColored ? maCustomColor : rBar);
+            if (!mbCustomColored)
+                aFill.Merge(rInk, 235);
+            mrRenderContext.SetFillColor(aFill);
+            mrRenderContext.DrawRect(aPill, 5, 5);
+        }
+        if (mbSelected)
+        {
+            mrRenderContext.SetFillColor(rAccent);
+            mrRenderContext.DrawRect(tools::Rectangle(Point(aPill.Left() + 3, aPill.Bottom() - 1),
+                                                      Point(aPill.Right() - 3, aPill.Bottom())));
+        }
+        if (mbProtect)
+        {
+            BitmapEx aBitmap(BMP_TAB_LOCK);
+            Point aPosition = maRect.TopLeft();
+            aPosition.AdjustX(2);
+            aPosition.AdjustY((maRect.getOpenHeight() - aBitmap.GetSizePixel().Height()) / 2);
+            mrRenderContext.DrawBitmapEx(aPosition, aBitmap);
+        }
+    }
