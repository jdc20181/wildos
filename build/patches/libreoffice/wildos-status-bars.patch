+SwParaStyleStatusBarControl::SwParaStyleStatusBarControl(sal_uInt16 _nSlotId, sal_uInt16 _nId,
+                                                         StatusBar& rStb)
+    : SfxStatusBarControl(_nSlotId, _nId, rStb)
+{
+}
+
+SwParaStyleStatusBarControl::~SwParaStyleStatusBarControl() {}
+
+void SwParaStyleStatusBarControl::StateChangedAtStatusBarControl(sal_uInt16 /*nSID*/,
+                                                                 SfxItemState eState,
+                                                                 const SfxPoolItem* pState)
+{
+    const SfxTemplateItem* pItem = eState == SfxItemState::DEFAULT
+                                       ? dynamic_cast<const SfxTemplateItem*>(pState)
+                                       : nullptr;
+    OUString aName;
+    if (pItem)
+    {
+        aName = pItem->GetStyleName();
+        if (Application::GetSettings().GetUILanguageTag().getLanguage() == "en")
+        {
+            if (pItem->GetStyleIdentifier() == "Text body")
+                aName = u"Body text"_ustr;
+            else if (pItem->GetStyleIdentifier() == "Quotations")
+                aName = u"Quote"_ustr;
+        }
+    }
+    GetStatusBar().SetItemText(GetId(), aName);
+}
