+{
+VCL_DLLPUBLIC bool ToolBoxHasNoArrows(const ToolBox& rToolBox)
+{
+    const ImplToolBoxPrivateData* pData = rToolBox.ImplGetToolBoxPrivateData();
+    return pData && pData->mbWildOSNoArrows;
+}
