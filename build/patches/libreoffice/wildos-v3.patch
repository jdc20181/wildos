+// The collapse chevron at the band's far right. The ribbon's page window
+// lies over the band, so the chevron is its own window on top of the page,
+// and hands its click to the tab control.
+class WildOSChevronCatcher final : public vcl::Window
+{
+public:
+    explicit WildOSChevronCatcher(vcl::Window* pParent)
+        : vcl::Window(pParent, 0)
+    {
+        SetHelpId(WILDOS_CHEVRON_ID);
+    }
+
+    virtual void Paint(vcl::RenderContext& rRenderContext, const tools::Rectangle&) override
+    {
+        const StyleSettings& rStyle = rRenderContext.GetSettings().GetStyleSettings();
+        const Size aSize(GetOutputSizePixel());
+        rRenderContext.Push(vcl::PushFlags::LINECOLOR | vcl::PushFlags::FILLCOLOR);
+        rRenderContext.SetAntialiasing(rRenderContext.GetAntialiasing() | AntialiasingFlags::Enable);
+        rRenderContext.SetLineColor();
+        rRenderContext.SetFillColor(lcl_wildosBandColor(rStyle));
+        rRenderContext.DrawRect(tools::Rectangle(Point(0, 0), aSize));
+        const double fHalf = aSize.Width() * 0.28, fRise = aSize.Width() * 0.16;
+        const double fX = aSize.Width() / 2.0, fY = aSize.Height() / 2.0;
+        basegfx::B2DPolygon aChevron;
+        aChevron.append(basegfx::B2DPoint(fX - fHalf, fY + fRise));
+        aChevron.append(basegfx::B2DPoint(fX, fY - fRise));
+        aChevron.append(basegfx::B2DPoint(fX + fHalf, fY + fRise));
+        rRenderContext.SetLineColor(lcl_mix(rStyle.GetDialogColor(), rStyle.GetDialogTextColor(), 0.55));
+        rRenderContext.SetFillColor();
+        rRenderContext.DrawPolyLine(aChevron, std::max(1.0, 1.5 * GetDPIScaleFactor()));
+        rRenderContext.Pop();
+    }
+
+    virtual void MouseButtonDown(const MouseEvent& rMEvt) override
+    {
+        const MouseEvent aEvt(rMEvt.GetPosPixel() + GetPosPixel(), rMEvt.GetClicks(),
+                              rMEvt.GetMode(), rMEvt.GetButtons(), rMEvt.GetModifier());
+        GetParent()->MouseButtonDown(aEvt);
+    }
+};
+
+vcl::Window* lcl_wildosChevron(const vcl::Window& rTabControl)
+{
+    for (vcl::Window* pChild = rTabControl.GetWindow(GetWindowType::FirstChild); pChild;
+         pChild = pChild->GetWindow(GetWindowType::Next))
+        if (pChild->GetHelpId() == WILDOS_CHEVRON_ID)
+            return pChild;
+    return nullptr;
+}
