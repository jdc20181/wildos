+// Wild OS: the thin strip at the gallery's right, as on the boards: up and
+// down, quiet while every style card is in view, and expand, which opens
+// the Styles deck with all the document's styles.
+class WildOSGalleryStrip final : public vcl::Window
+{
+public:
+    explicit WildOSGalleryStrip(vcl::Window* pParent)
+        : vcl::Window(pParent, 0)
+    {
+    }
+
+    virtual void Paint(vcl::RenderContext& rRenderContext, const tools::Rectangle&) override
+    {
+        const StyleSettings& rStyle = rRenderContext.GetSettings().GetStyleSettings();
+        const Color aBand(lcl_bandColor());
+        const Color aInk(rStyle.GetDialogColor().IsDark() ? COL_WHITE : Color(0x1f, 0x26, 0x33));
+        Color aActive(aBand), aQuiet(aBand);
+        aActive.Merge(aInk, sal_uInt8(255 * 0.45));
+        aQuiet.Merge(aInk, sal_uInt8(255 * 0.78));
+        const Size aSize(GetOutputSizePixel());
+        rRenderContext.Push(vcl::PushFlags::LINECOLOR | vcl::PushFlags::FILLCOLOR);
+        rRenderContext.SetAntialiasing(rRenderContext.GetAntialiasing() | AntialiasingFlags::Enable);
+        rRenderContext.SetLineColor();
+        rRenderContext.SetFillColor(aBand);
+        rRenderContext.DrawRect(tools::Rectangle(Point(0, 0), aSize));
+        const double fThird = aSize.Height() / 3.0, fHalf = aSize.Width() * 0.25,
+                     fRise = aSize.Width() * 0.13;
+        const double fLine = std::max(1.0, 1.5 * GetDPIScaleFactor());
+        auto chevron = [&](double fY, bool bUp) {
+            const double fX = aSize.Width() / 2.0;
+            basegfx::B2DPolygon aPoly;
+            aPoly.append(basegfx::B2DPoint(fX - fHalf, fY + (bUp ? fRise : -fRise)));
+            aPoly.append(basegfx::B2DPoint(fX, fY + (bUp ? -fRise : fRise)));
+            aPoly.append(basegfx::B2DPoint(fX + fHalf, fY + (bUp ? fRise : -fRise)));
+            rRenderContext.DrawPolyLine(aPoly, fLine);
+        };
+        rRenderContext.SetFillColor();
+        rRenderContext.SetLineColor(aQuiet);
+        chevron(fThird * 0.5, true);
+        chevron(fThird * 1.5, false);
+        rRenderContext.SetLineColor(aActive);
+        chevron(fThird * 2.5 - fRise, false);
+        chevron(fThird * 2.5 + fRise * 0.9, false);
+        rRenderContext.Pop();
+    }
+
+    virtual void MouseButtonDown(const MouseEvent& rMEvt) override
+    {
+        if (rMEvt.IsLeft() && rMEvt.GetPosPixel().Y() > GetOutputSizePixel().Height() * 2 / 3)
+            comphelper::dispatchCommand(u".uno:SidebarDeck.StyleListDeck"_ustr, {});
+    }
+};
+}
