+// The collapse chevron: 16 px square, 12 px in from the band's right edge
+// and 6 px up from its foot.
+tools::Rectangle NotebookbarTabControlBase::ImplWildOSChevronRect() const
+{
+    const Size aSize(GetOutputSizePixel());
+    const tools::Long nBox = lcl_wpx(this, 16);
+    return tools::Rectangle(Point(aSize.Width() - lcl_wpx(this, 12) - nBox,
