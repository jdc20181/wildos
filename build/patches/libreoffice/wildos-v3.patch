+namespace
+{
+// The notebook bar keeps the height it was given, and the frame lays out
+// round it; after folding or unfolding, give it its new height and lay the
+// frame out again.
+void lcl_wildosRefit(vcl::Window& rTabControl)
+{
+    rTabControl.queue_resize();
+    rTabControl.Invalidate();
+    for (vcl::Window* pWin = rTabControl.GetParent(); pWin; pWin = pWin->GetParent())
+    {
+        if (NotebookBar* pBar = dynamic_cast<NotebookBar*>(pWin))
+        {
+            const Size aOptimal(pBar->GetOptimalSize());
+            pBar->setPosSizePixel(0, 0, pBar->GetSizePixel().Width(), aOptimal.Height(),
+                                  PosSizeFlags::Height);
+            if (vcl::Window* pBorder = pBar->GetParent())
+                pBorder->Resize();
+            break;
+        }
+    }
+}
