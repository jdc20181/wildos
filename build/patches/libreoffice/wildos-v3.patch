+// Wild OS: Open, Save as, Export and Insert picture use the Wild OS Open and
+// Save dialog, the one every other app gets through the desktop portal
+// (PLASMA_INTEGRATION_USE_PORTAL=1 in a Wild OS session). LibreOffice's own
+// options (Save with password, Edit filter settings, Insert as link, an
+// image's anchor) travel as the portal's choices. Without a portal, or with
+// a control the portal can't carry, LibreOffice's own dialog is used.
+namespace wildosportal
+{
+struct FilterRule
+{
+    uint type = 0;
+    QString pattern;
+};
+struct Filter
+{
+    QString name;
+    QList<FilterRule> rules;
+};
+struct ChoiceOption
+{
+    QString id;
+    QString label;
+};
+struct Choice
+{
+    QString id;
+    QString label;
+    QList<ChoiceOption> options;
+    QString selected;
+};
+}
+Q_DECLARE_METATYPE(wildosportal::FilterRule)
+Q_DECLARE_METATYPE(wildosportal::Filter)
+Q_DECLARE_METATYPE(QList<wildosportal::Filter>)
+Q_DECLARE_METATYPE(wildosportal::ChoiceOption)
+Q_DECLARE_METATYPE(wildosportal::Choice)
+Q_DECLARE_METATYPE(QList<wildosportal::Choice>)
+
+namespace wildosportal
+{
+QDBusArgument& operator<<(QDBusArgument& a, const FilterRule& r)
+{
+    a.beginStructure();
+    a << r.type << r.pattern;
+    a.endStructure();
+    return a;
+}
+const QDBusArgument& operator>>(const QDBusArgument& a, FilterRule& r)
+{
+    a.beginStructure();
+    a >> r.type >> r.pattern;
+    a.endStructure();
+    return a;
+}
+QDBusArgument& operator<<(QDBusArgument& a, const Filter& f)
+{
+    a.beginStructure();
+    a << f.name;
+    a.beginArray(qMetaTypeId<FilterRule>());
+    for (const FilterRule& r : f.rules)
+        a << r;
+    a.endArray();
+    a.endStructure();
+    return a;
+}
+const QDBusArgument& operator>>(const QDBusArgument& a, Filter& f)
+{
+    a.beginStructure();
+    a >> f.name;
+    a.beginArray();
+    f.rules.clear();
+    while (!a.atEnd())
+    {
+        FilterRule r;
+        a >> r;
+        f.rules.append(r);
+    }
+    a.endArray();
+    a.endStructure();
+    return a;
+}
+QDBusArgument& operator<<(QDBusArgument& a, const ChoiceOption& o)
+{
+    a.beginStructure();
+    a << o.id << o.label;
+    a.endStructure();
+    return a;
+}
+const QDBusArgument& operator>>(const QDBusArgument& a, ChoiceOption& o)
+{
+    a.beginStructure();
+    a >> o.id >> o.label;
+    a.endStructure();
+    return a;
+}
+QDBusArgument& operator<<(QDBusArgument& a, const Choice& c)
+{
+    a.beginStructure();
+    a << c.id << c.label;
+    a.beginArray(qMetaTypeId<ChoiceOption>());
+    for (const ChoiceOption& o : c.options)
+        a << o;
+    a.endArray();
+    a << c.selected;
+    a.endStructure();
+    return a;
+}
+const QDBusArgument& operator>>(const QDBusArgument& a, Choice& c)
+{
+    a.beginStructure();
+    a >> c.id >> c.label;
+    a.beginArray();
+    c.options.clear();
+    while (!a.atEnd())
+    {
+        ChoiceOption o;
+        a >> o;
+        c.options.append(o);
+    }
+    a.endArray();
+    a >> c.selected;
+    a.endStructure();
+    return a;
+}
+
+void registerTypes()
+{
+    static bool bDone = false;
+    if (bDone)
+        return;
+    bDone = true;
+    qDBusRegisterMetaType<FilterRule>();
+    qDBusRegisterMetaType<Filter>();
+    qDBusRegisterMetaType<QList<Filter>>();
+    qDBusRegisterMetaType<ChoiceOption>();
+    qDBusRegisterMetaType<Choice>();
+    qDBusRegisterMetaType<QList<Choice>>();
+}
+
+// "Word 2007 (*.docx)" -> its name and patterns, as appendFilter built it.
+Filter toFilter(const QString& rNamed)
+{
+    Filter f;
+    const int nOpen = rNamed.lastIndexOf(QStringLiteral(" ("));
+    f.name = nOpen > 0 ? rNamed.left(nOpen) : rNamed;
+    const QString sGlobs = nOpen > 0 ? rNamed.mid(nOpen + 2).chopped(1) : QString();
+    for (const QString& sGlob : sGlobs.split(u' ', Qt::SkipEmptyParts))
+        f.rules.append(FilterRule{ 0, sGlob });
+    f.name.replace(QStringLiteral("\\/"), QStringLiteral("/"));
+    return f;
+}
+
+QString plainLabel(QString s)
+{
+    s.remove(u'&');
+    s.remove(u'~');
+    return s;
+}
+}
+
+bool QtFilePicker::execPortal(int& rResult)
+{
+    using namespace wildosportal;
+    // Wild OS: every Open and Save goes through the desktop portal, the one
+    // dialog all apps share, whenever the portal is running.
+    if (m_bIsFolderPicker)
+        return false;
+    QDBusConnection aBus = QDBusConnection::sessionBus();
+    if (!aBus.isConnected() || !aBus.interface()
+        || !aBus.interface()->isServiceRegistered(QStringLiteral("org.freedesktop.portal.Desktop")))
+        return false;
+    registerTypes();
+
+    const bool bSave = m_pFileDialog->acceptMode() == QFileDialog::AcceptSave;
+    QVariantMap aOptions;
+    const QString sToken = QStringLiteral("wildos%1").arg(QRandomGenerator::global()->generate());
+    aOptions[QStringLiteral("handle_token")] = sToken;
+    aOptions[QStringLiteral("modal")] = true;
+    if (!bSave)
+        aOptions[QStringLiteral("multiple")] = m_pFileDialog->fileMode() == QFileDialog::ExistingFiles;
+
+    QList<Filter> aFilters;
+    const QString sCurrent = !m_aCurrentFilter.isEmpty() ? m_aCurrentFilter
+                                                         : m_pFileDialog->selectedNameFilter();
+    for (const QString& rNamed : std::as_const(m_aNamedFilterList))
+    {
+        aFilters.append(toFilter(rNamed));
+        if (rNamed == sCurrent)
+            aOptions[QStringLiteral("current_filter")] = QVariant::fromValue(aFilters.constLast());
+    }
+    if (!aFilters.isEmpty())
+        aOptions[QStringLiteral("filters")] = QVariant::fromValue(aFilters);
+
+    // LibreOffice's options as choices: its checkboxes (bar the automatic
+    // extension, which the dialog keeps in step with the type itself, and
+    // a preview the dialog can't show) and its lists.
+    QList<Choice> aChoices;
+    for (auto it = m_aCustomWidgetsMap.cbegin(); it != m_aCustomWidgetsMap.cend(); ++it)
+    {
+        QWidget* pWidget = it.value();
+        if (pWidget->isHidden())
+            continue;
+        if (QCheckBox* pBox = qobject_cast<QCheckBox*>(pWidget))
+        {
+            if (it.key() == CHECKBOX_AUTOEXTENSION || it.key() == CHECKBOX_PREVIEW)
+                continue;
+            if (!pBox->isEnabled())
+                continue;
+            aChoices.append(Choice{ QString::number(it.key()), plainLabel(pBox->text()), {},
+                                    pBox->isChecked() ? QStringLiteral("true")
+                                                      : QStringLiteral("false") });
+        }
+        else if (QComboBox* pList = qobject_cast<QComboBox*>(pWidget))
+        {
+            if (pList->count() == 0)
+                continue;
+            Choice aChoice;
+            aChoice.id = QString::number(it.key());
+            for (auto lit = m_aCustomWidgetsMap.cbegin(); lit != m_aCustomWidgetsMap.cend(); ++lit)
+            {
+                QLabel* pLabel = qobject_cast<QLabel*>(lit.value());
+                if (pLabel && pLabel->buddy() == pList)
+                    aChoice.label = plainLabel(pLabel->text());
+            }
+            for (int i = 0; i < pList->count(); ++i)
+                aChoice.options.append(ChoiceOption{ QString::number(i), pList->itemText(i) });
+            aChoice.selected = QString::number(std::max(pList->currentIndex(), 0));
+            aChoices.append(aChoice);
+        }
+        else if (!qobject_cast<QLabel*>(pWidget))
+            return false; // a control the portal can't carry: LibreOffice's own dialog
+    }
+    if (!aChoices.isEmpty())
+        aOptions[QStringLiteral("choices")] = QVariant::fromValue(aChoices);
+
+    if (bSave && !m_aDefaultName.isEmpty())
+        aOptions[QStringLiteral("current_name")] = m_aDefaultName;
+    const QString sFolder = m_pFileDialog->directory().absolutePath();
+    if (!sFolder.isEmpty())
+        aOptions[QStringLiteral("current_folder")] = QByteArray(QFile::encodeName(sFolder) + '\0');
+
+    // The request's object, known before the call so its answer can't be missed.
+    QString sSender = aBus.baseService().mid(1);
+    sSender.replace(u'.', u'_');
+    QString sRequest = QStringLiteral("/org/freedesktop/portal/desktop/request/%1/%2").arg(sSender, sToken);
+    const QString sDesktop = QStringLiteral("org.freedesktop.portal.Desktop");
+    const QString sRequestIface = QStringLiteral("org.freedesktop.portal.Request");
+    aBus.connect(sDesktop, sRequest, sRequestIface, QStringLiteral("Response"), this,
+                 SLOT(portalResponse(uint, QVariantMap)));
+
+    QDBusMessage aCall = QDBusMessage::createMethodCall(
+        sDesktop, QStringLiteral("/org/freedesktop/portal/desktop"),
+        QStringLiteral("org.freedesktop.portal.FileChooser"),
+        bSave ? QStringLiteral("SaveFile") : QStringLiteral("OpenFile"));
+    aCall << QString() << m_pFileDialog->windowTitle() << aOptions;
+    const QDBusMessage aReply = aBus.call(aCall);
+    if (aReply.type() != QDBusMessage::ReplyMessage || aReply.arguments().isEmpty())
+    {
+        aBus.disconnect(sDesktop, sRequest, sRequestIface, QStringLiteral("Response"), this,
+                        SLOT(portalResponse(uint, QVariantMap)));
+        return false;
+    }
+    const QString sHandle = qvariant_cast<QDBusObjectPath>(aReply.arguments().constFirst()).path();
+    if (!sHandle.isEmpty() && sHandle != sRequest)
+    {
+        aBus.disconnect(sDesktop, sRequest, sRequestIface, QStringLiteral("Response"), this,
+                        SLOT(portalResponse(uint, QVariantMap)));
+        sRequest = sHandle;
+        aBus.connect(sDesktop, sRequest, sRequestIface, QStringLiteral("Response"), this,
+                     SLOT(portalResponse(uint, QVariantMap)));
+    }
+
+    m_nPortalResponse = 2;
+    m_aPortalResults.clear();
+    QEventLoop aLoop;
+    m_pPortalLoop = &aLoop;
+    {
+        SolarMutexReleaser aReleaser;
+        aLoop.exec();
+    }
+    m_pPortalLoop = nullptr;
+    aBus.disconnect(sDesktop, sRequest, sRequestIface, QStringLiteral("Response"), this,
+                    SLOT(portalResponse(uint, QVariantMap)));
+
+    m_bPortalUsed = true;
+    m_aPortalUrls.clear();
+    rResult = QFileDialog::Rejected;
+    if (m_nPortalResponse != 0)
+        return true;
+
+    for (const QString& sUri : m_aPortalResults.value(QStringLiteral("uris")).toStringList())
+        m_aPortalUrls.append(QUrl(sUri));
+
+    const QVariant aChosen = m_aPortalResults.value(QStringLiteral("choices"));
+    if (aChosen.canConvert<QDBusArgument>())
+    {
+        const QDBusArgument aArg = aChosen.value<QDBusArgument>();
+        aArg.beginArray();
+        while (!aArg.atEnd())
+        {
+            QString sId, sValue;
+            aArg.beginStructure();
+            aArg >> sId >> sValue;
+            aArg.endStructure();
+            QWidget* pWidget = m_aCustomWidgetsMap.value(sId.toShort());
+            if (QCheckBox* pBox = qobject_cast<QCheckBox*>(pWidget))
+                pBox->setChecked(sValue == u"true");
+            else if (QComboBox* pList = qobject_cast<QComboBox*>(pWidget))
+                pList->setCurrentIndex(sValue.toInt());
+        }
+        aArg.endArray();
+    }
+    if (QCheckBox* pAuto = qobject_cast<QCheckBox*>(m_aCustomWidgetsMap.value(CHECKBOX_AUTOEXTENSION)))
+        pAuto->setChecked(true);
+
+    const QVariant aFilter = m_aPortalResults.value(QStringLiteral("current_filter"));
+    if (aFilter.canConvert<QDBusArgument>())
+    {
+        Filter aChosenFilter;
+        aFilter.value<QDBusArgument>() >> aChosenFilter;
+        for (const QString& rNamed : std::as_const(m_aNamedFilterList))
+        {
+            if (toFilter(rNamed).name == aChosenFilter.name)
+            {
+                m_aCurrentFilter = rNamed;
+                m_pFileDialog->selectNameFilter(rNamed);
+                break;
+            }
+        }
+    }
+    rResult = m_aPortalUrls.isEmpty() ? QFileDialog::Rejected : QFileDialog::Accepted;
+    return true;
+}
+
+void QtFilePicker::portalResponse(uint nResponse, const QVariantMap& rResults)
+{
+    m_nPortalResponse = nResponse;
+    m_aPortalResults = rResults;
+    if (m_pPortalLoop)
+        m_pPortalLoop->quit();
+}
