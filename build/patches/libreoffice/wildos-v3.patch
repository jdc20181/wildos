+
+void NotebookbarTabControlBase::MouseButtonDown(const MouseEvent& rMEvt)
+{
+    if (m_bWildOS && rMEvt.IsLeft())
+    {
+        if (!m_bWildOSCollapsed && ImplWildOSChevronRect().Contains(rMEvt.GetPosPixel()))
+        {
+            m_bWildOSCollapsed = true;
+            lcl_wildosRefit(*this);
+            return;
+        }
+        if (m_bWildOSCollapsed && rMEvt.GetPosPixel().Y() < lcl_wpx(this, WILDOS_ROW_HEIGHT))
+        {
+            m_bWildOSCollapsed = false;
+            lcl_wildosRefit(*this);
+        }
+    }
+    TabControl::MouseButtonDown(rMEvt);
+}
