+// Wild OS: a recent file's folder and when it last changed, "Documents ·
+// Today", shown at the right of its row as on the OfficeFileMenu board.
+OUString lcl_wildosWhereAndWhen(const INetURLObject& rURL)
+{
+    INetURLObject aFolder(rURL);
+    aFolder.removeSegment();
+    OUString aWhere = aFolder.GetLastName(INetURLObject::DecodeMechanism::WithCharset);
+    if (aWhere.isEmpty())
+        aWhere = aFolder.getFSysPath(FSysStyle::Detect);
+
+    osl::DirectoryItem aItem;
+    osl::FileStatus aStatus(osl_FileStatus_Mask_ModifyTime);
+    if (osl::DirectoryItem::get(rURL.GetMainURL(INetURLObject::DecodeMechanism::NONE), aItem)
+            != osl::FileBase::E_None
+        || aItem.getFileStatus(aStatus) != osl::FileBase::E_None)
+        return aWhere;
+
+    TimeValue aModified = aStatus.getModifyTime();
+    ::DateTime aWhen(::DateTime::CreateFromUnixTime(aModified.Seconds));
+    aWhen.ConvertToLocalTime();
+    const ::Date aToday(::Date::SYSTEM);
+    const sal_Int32 nDaysAgo = aToday - ::Date(aWhen);
+    OUString aDay;
+    if (nDaysAgo == 0)
+        aDay = u"Today"_ustr;
+    else if (nDaysAgo == 1)
+        aDay = u"Yesterday"_ustr;
+    else
+    {
+        const LocaleDataWrapper& rLocale = SvtSysLocale().GetLocaleData();
+        const css::uno::Sequence<css::i18n::CalendarItem2> aMonths
+            = rLocale.getDefaultCalendarMonths();
+        const sal_uInt16 nMonth = aWhen.GetMonth();
+        aDay = OUString::number(aWhen.GetDay()) + " "
+               + (nMonth >= 1 && nMonth <= aMonths.getLength() ? aMonths[nMonth - 1].AbbrevName
+                                                              : OUString::number(nMonth));
+        if (aWhen.GetYear() != aToday.GetYear())
+            aDay += " " + OUString::number(aWhen.GetYear());
+    }
+    return aWhere + u" · "_ustr + aDay;
+}
+}
