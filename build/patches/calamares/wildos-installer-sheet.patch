+/** @brief On a sheet, message boxes are sheets too
+ *
+ * They lose the window frame, so the title moves inside as the first line,
+ * and they draw their own rounded background in the stylesheet's colour
+ * (object name *sheetDialog*).
+ */
+class SheetMessageBox : public QMessageBox
+{
+public:
+    SheetMessageBox( const QString& title,
+                     const QString& text,
+                     QMessageBox::StandardButtons buttons,
+                     QWidget* parent )
+        : QMessageBox( QMessageBox::Question, title, text, buttons, parent )
+    {
+        if ( Branding::instance() && Branding::instance()->windowIsSheet() )
+        {
+            m_sheet = true;
+            setObjectName( QStringLiteral( "sheetDialog" ) );
+            setWindowFlag( Qt::FramelessWindowHint );
+            setAttribute( Qt::WA_TranslucentBackground );
+            setIcon( QMessageBox::NoIcon );
+            setText( title );
+            setInformativeText( text );
+            if ( layout() )
+            {
+                layout()->setContentsMargins( 28, 26, 28, 24 );
+            }
+        }
+    }
+
+protected:
+    void showEvent( QShowEvent* event ) override
+    {
+        // The underlined access keys of the stock labels look out of place
+        // on the sheet's buttons; Return and Escape still answer.
+        if ( m_sheet )
+        {
+            for ( auto* button : buttons() )
+            {
+                button->setText( button->text().remove( QRegularExpression( QStringLiteral( "&(?!&)" ) ) ) );
+                button->setIcon( QIcon() );
+            }
+        }
+        QMessageBox::showEvent( event );
+    }
+
+    void paintEvent( QPaintEvent* event ) override
+    {
+        if ( !m_sheet )
+        {
+            QMessageBox::paintEvent( event );
+            return;
+        }
+        QPainter p( this );
+        p.setRenderHint( QPainter::Antialiasing );
+        p.setPen( QColor( 255, 255, 255, 31 ) );
+        p.setBrush( palette().brush( QPalette::Window ) );
+        p.drawRoundedRect( QRectF( rect() ).adjusted( 0.5, 0.5, -0.5, -0.5 ), 16, 16 );
+    }
+
+private:
+    bool m_sheet = false;
+};
+}  // namespace
