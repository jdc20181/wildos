+/** @brief The dimmed wallpaper with the installer's glass sheet drawn on it
+ *
+ * Used when Branding::windowIsSheet(). The sheet widget paints nothing
+ * itself: this widget draws its shadow, a blurred copy of the wallpaper
+ * behind it and the tint, so the panels on the sheet can be transparent.
+ */
+class SheetBackdrop : public QWidget
+{
+public:
+    SheetBackdrop( const QString& wallpaper, QWidget* parent )
+        : QWidget( parent )
+        , m_wallpaper( wallpaper )
+    {
+    }
+
+    void setSheet( QWidget* sheet ) { m_sheet = sheet; }
+
+protected:
+    void paintEvent( QPaintEvent* ) override
+    {
+        const QRect sheetRect = m_sheet ? m_sheet->geometry() : QRect();
+        if ( m_cache.size() != size() || m_cachedSheet != sheetRect )
+        {
+            rebuild( sheetRect );
+        }
+        QPainter p( this );
+        p.drawPixmap( 0, 0, m_cache );
+    }
+
+private:
+    // Scaling down and back up is a cheap, smooth enough blur for a backdrop.
+    static QImage blurred( const QImage& image, int factor )
+    {
+        const QSize small( qMax( 1, image.width() / factor ), qMax( 1, image.height() / factor ) );
+        return image.scaled( small, Qt::IgnoreAspectRatio, Qt::SmoothTransformation )
+            .scaled( image.size(), Qt::IgnoreAspectRatio, Qt::SmoothTransformation );
+    }
+
+    void rebuild( const QRect& sheetRect )
+    {
+        QImage canvas( size(), QImage::Format_ARGB32_Premultiplied );
+        canvas.fill( QColor( 0x1d, 0x2b, 0x52 ) );
+        QPainter p( &canvas );
+        p.setRenderHint( QPainter::Antialiasing );
+        p.setRenderHint( QPainter::SmoothPixmapTransform );
+
+        const QImage wallpaper( m_wallpaper );
+        if ( !wallpaper.isNull() )
+        {
+            const QImage cover
+                = wallpaper.scaled( size(), Qt::KeepAspectRatioByExpanding, Qt::SmoothTransformation );
+            const int x = ( cover.width() - width() ) / 2;
+            const int y = int( ( cover.height() - height() ) * 0.45 );
+            p.drawImage( 0, 0, cover, x, y, width(), height() );
+        }
+        p.fillRect( rect(), QColor( 6, 10, 26, 102 ) );
+
+        if ( sheetRect.isValid() )
+        {
+            const qreal radius = 20;
+            const int spread = 110;
+            QImage shadow( sheetRect.size() + QSize( 2 * spread, 2 * spread ), QImage::Format_ARGB32_Premultiplied );
+            shadow.fill( Qt::transparent );
+            {
+                QPainter sp( &shadow );
+                sp.setRenderHint( QPainter::Antialiasing );
+                sp.setPen( Qt::NoPen );
+                sp.setBrush( QColor( 4, 8, 24, 140 ) );
+                sp.drawRoundedRect(
+                    QRectF( spread, spread, sheetRect.width(), sheetRect.height() ), radius, radius );
+            }
+            p.drawImage( sheetRect.topLeft() + QPoint( -spread, 40 - spread ), blurred( shadow, 28 ) );
+
+            const QImage behind = blurred( canvas.copy( sheetRect ), 24 );
+            QPainterPath sheet;
+            sheet.addRoundedRect( QRectF( sheetRect ), radius, radius );
+            p.setClipPath( sheet );
+            p.drawImage( sheetRect.topLeft(), behind );
+            p.fillRect( sheetRect, QColor( 18, 22, 40, 219 ) );
+            p.setClipping( false );
+            p.setPen( QPen( QColor( 255, 255, 255, 31 ), 1 ) );
+            p.setBrush( Qt::NoBrush );
+            p.drawRoundedRect( QRectF( sheetRect ).adjusted( 0.5, 0.5, -0.5, -0.5 ), radius - 0.5, radius - 0.5 );
+        }
+        p.end();
+        m_cache = QPixmap::fromImage( canvas );
+        m_cachedSheet = sheetRect;
+    }
+
+    QString m_wallpaper;
+    QWidget* m_sheet = nullptr;
+    QPixmap m_cache;
+    QRect m_cachedSheet;
+};
+}  // namespace
