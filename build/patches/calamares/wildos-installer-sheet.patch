+/** @brief Is the step at @p index one that has no page of its own?
+ *
+ * A distribution can show the answers of several modules on one page. The
+ * other modules keep their place in the sequence and their jobs, but are
+ * listed in global storage under *passThroughSteps*: next() and back() run
+ * their onActivate() and onLeave() and move straight past them. A module joins
+ * the list with `passThrough: true` in its configuration, and a page can add
+ * or remove a step while Calamares runs, for instance to skip a step that
+ * has nothing to ask.
+ */
+static bool
+stepIsPassThrough( const ViewStepList& steps, int index )
+{
+    if ( index < 0 || index >= steps.count() || !JobQueue::instance() )
+    {
+        return false;
+    }
+    const auto list
+        = JobQueue::instance()->globalStorage()->value( QStringLiteral( "passThroughSteps" ) ).toStringList();
+    return list.contains( steps.at( index )->moduleInstanceKey().toString() );
+}
