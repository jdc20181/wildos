+void
+ViewManager::setPassThrough( const QString& instanceKey, bool passThrough )
+{
+    auto* gs = JobQueue::instance()->globalStorage();
+    auto list = gs->value( QStringLiteral( "passThroughSteps" ) ).toStringList();
+    if ( passThrough == list.contains( instanceKey ) )
+    {
+        return;
+    }
+    if ( passThrough )
+    {
+        list.append( instanceKey );
+    }
+    else
+    {
+        list.removeAll( instanceKey );
+    }
+    gs->insert( QStringLiteral( "passThroughSteps" ), list );
+}
