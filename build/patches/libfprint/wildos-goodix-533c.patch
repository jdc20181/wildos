+  if (primary_filtered_delta < 0)
+    primary_filtered_delta = -primary_filtered_delta;
+  if (state[0] >= 4 || state[2] >= 4 ||
+      (state[0] >= 2 && state[1] >= 1) ||
+      (state[0] >= 2 && metrics[GOODIX_MILAN_POLICY_METRIC_DETAIL] < 230 &&
+       metrics[GOODIX_MILAN_POLICY_METRIC_COMBINED] < 215 &&
+       image_coverage <= 60) ||
