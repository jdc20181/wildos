+void
+assert_generic_append_material (GBytes *probe,
+                                GBytes *before,
+                                GBytes *after)
+{
+  static const size_t probe_owned_fields[] = { 2, 3, 4, 8, 10 };
+  static const int32_t appended_relation_values[7] = {
+    0, 0x100, 0, 0, 0, 0x100, 0,
