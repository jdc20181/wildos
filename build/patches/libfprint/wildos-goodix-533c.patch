+++ b/libfprint/drivers/goodix53x5/device/commands.h
@@ -0,0 +1,185 @@
+/*
+ * Goodix 53x5 driver for libfprint — Named device commands and reply parsers
+ * Copyright (C) 2024 goodix-fp-linux-dev contributors
+ *
