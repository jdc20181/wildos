 # Supported by libfprint driver goodixmoc
 usb:v27C6p5840*
 usb:v27C6p6014*
@@ -440,7 +445,6 @@ usb:v27C6p5301*
 usb:v27C6p530C*
 usb:v27C6p532D*
 usb:v27C6p5335*
-usb:v27C6p533C*
 usb:v27C6p5381*
