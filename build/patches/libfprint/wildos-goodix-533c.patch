+static void
+unpack_test_template (GBytes                       *template_bytes,
+                       GoodixMilanUnpackedTemplate *unpacked)
+{
+  const guint8 *data;
+  gsize size;
+
+  data = g_bytes_get_data (template_bytes, &size);
+  g_assert_cmpint (goodix_milan_template_unpack (data, size, unpacked), ==, 0);
