+  MILAN_FEATURE_TAG_SCALAR_BB = 0xbb,
+  MILAN_FEATURE_TAG_SCALAR_BC = 0xbc,
+  MILAN_FEATURE_TAG_SCALAR_BD = 0xbd,
+  MILAN_FEATURE_TAG_SCALAR_BE = 0xbe,
+  MILAN_FEATURE_TAG_ANTIFAKE = 0xbf,
