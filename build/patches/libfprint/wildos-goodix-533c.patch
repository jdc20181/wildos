+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#pragma once
+
+#include "driver-private.h"
+
+/* Command bytes are copied when the request is accepted. */
+typedef struct _GoodixCmd
+{
+  guint8   category;
+  guint8   command;
+  guint8  *payload;
+  gsize    payload_len;
+  gboolean use_checksum;
+} GoodixCmd;
+
+typedef struct
+{
+  GoodixCmd cmd;
+  /* A2 reset with data uses the shared A/0,A/1,A/4 event, ACK 500 ms,
+   * response 1000 ms, one attempt. Type-zero IRQ payload is {5,20}; its
+   * completed reply view contains the little-endian three-byte IRQ value.
+   * Without data the type-zero payload is {1,20}, ACK-only. */
+  gboolean expect_data;
+  /* Retained caller hint; IN now survives every command until quiesce. */
+  gboolean idle_after_ack;
+} GoodixTransportRequest;
+
+typedef struct
+{
+  /* Last accepted odd ACK; ordinary exhaustion follows native retry policy. */
+  guint8 ack_status;
+  gboolean ordinary_exhaustion;
+  gboolean write_cancelled;
+  gboolean restart_gtls;
+} GoodixTransportResult;
+
+/* One row of the native command table: the 53x5 ACK and data budgets, the
+ * response slot a reply lands in and whether the command is retried. */
+typedef struct
+{
+  guint8 command;
+  guint ack_ms;
+  guint response_ms;
+  GoodixResponseSlot response_slot;
+  gboolean retry;
+} GoodixCommandPolicy;
+
+/* Returns the native table's row for the command with wire byte @command,
+ * or NULL when the table does not list it. */
+const GoodixCommandPolicy *goodix_cmd_policy (guint8 command);
+
+/* Error ownership transfers to done. Result is borrowed for that call only.
+ * The completed operation is detached before caller code can submit another. */
+typedef void (*GoodixTransportDone) (FpDevice *dev,
+                                    const GoodixTransportResult *result,
+                                    GError *error, gpointer data);
+typedef void (*GoodixTransportJoined) (FpDevice *dev, gpointer data);
+
+/* Copy the request before returning. The independent IN remains posted. */
+void goodix_transport_command (FpDevice *dev, const GoodixTransportRequest *request,
+                                GoodixTransportDone done, gpointer data);
+/* Writes a raw TLS record; completes once written, as no sensor ACKs one. */
+void goodix_transport_send_record (FpDevice *dev, GBytes *record,
+                                   GoodixTransportDone done, gpointer data);
+
+/* Entry points of the receiver for GoodixLink.receive: protocol messages
+ * go in as direct-framing cells, encrypted images and category-D data whole. */
+void goodix_rx_cell (GoodixTransport *operation, const guint8 *buffer,
+                     gsize cell_length);
+gboolean goodix_rx_image (GoodixTransport *operation, const guint8 *payload,
+                          gsize len);
+void goodix_mcu_publish (FpiDeviceGoodix53x5 *self, const guint8 *payload,
+                         gsize len);
+void goodix_transport_wait_event (FpDevice *dev, GoodixProfile9FdtWaitMode mode,
+                                   GoodixTransportDone done, gpointer data);
+void goodix_transport_wait_mcu (FpDevice *dev, guint timeout, gsize length,
+                                GoodixTransportDone done, gpointer data);
+void goodix_transport_reset_mcu (FpDevice *dev);
+void goodix_transport_cancel_event (FpDevice *dev);
+/* Foreground and CPU work must already be settled. Join the continuous IN;
+ * this is not a policy to cancel outstanding commands or CPU work. */
+void goodix_transport_quiesce (FpDevice *dev, GoodixTransportJoined joined,
+                               gpointer data);
+
+/* Bytes per USB bulk packet; both framings pad writes to whole packets. */
+#define GOODIX_USB_CHUNK_SIZE 64
+
+/* Timeouts in ms */
+#define GOODIX_ACK_TIMEOUT    2000
+#define GOODIX_DATA_TIMEOUT   5000
+
+/* Commit the native parser-side base updates before publishing a notification.
+ * Dispatch must not apply these updates again for a selected notification. */
+void goodix_recv_apply_fdt_event (FpDevice                     *dev,
+                                 GoodixFdtEventType             type,
+                                 const GoodixProfile9FdtEvent  *event);
+
+/* Copy the validated notification selected by wait_event. Mode was used at
+ * decode time; selected type/event/predecessor are independent of later RX. */
+gboolean goodix_recv_select_fdt (FpDevice *dev, GoodixFdtEventType *type,
+                                 GoodixProfile9FdtEvent *event,
+                                 guint16 *prior_down, GError **error);
+
+/* Invalidate transport-local reception only after its owners have joined. */
+void goodix_transport_invalidate (FpDevice *dev);
+
+/* Access the transport's validated response view. Generic command completion
+ * selects the retained shared cache (and awaited selector), including data
+ * received before ACK. Other packets borrow RX storage. Consume either view
+ * before starting another receive; this does not reparse the wire bytes. */
+gboolean goodix_parse_reply (FpDevice      *dev,
+                             guint8        *out_category,
+                             guint8        *out_command,
+                             const guint8 **out_payload,
+                             gsize         *out_payload_len,
+                             GError       **error);
+
+gboolean goodix_parse_reply_exact (FpDevice      *dev,
+                                   guint8         expected_category,
+                                   guint8         expected_command,
+                                   const guint8 **out_payload,
+                                   gsize         *out_payload_len,
+                                   GError       **error);
diff --git a/libfprint/drivers/goodix53x5/driver-private.h b/libfprint/drivers/goodix53x5/driver-private.h
new file mode 100644
index 0000000..04663dc
--- /dev/null
+++ b/libfprint/drivers/goodix53x5/driver-private.h
@@ -0,0 +1,322 @@
+/*
+ * Goodix 53x5 driver for libfprint — Private device state
+ * Copyright (C) 2024 goodix-fp-linux-dev contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#pragma once
+
+#include "fpi-device.h"
+#include "fpi-ssm.h"
+#include "fpi-usb-transfer.h"
+
+#include "goodix53x5.h"
+#include "device/proto.h"
+#include "device/crypto.h"
+#include "family.h"
+#include "device/debug.h"
+#include "device/base.h"
+#include "device/health.h"
+#include "milan/match/match.h"
+
+/* id_table driver_data selecting goodix_family_gm168sec. */
+#define GOODIX_FAMILY_GM168SEC 1
+
+/* USB interface claimed at open and released at close. */
+#define GOODIX_USB_INTERFACE(dev) \
+  (goodix_family (FPI_DEVICE_GOODIX53X5 (dev))->link.usb_interface)
+
+/* Sensor dimensions */
+#define GOODIX_SENSOR_WIDTH 108
+#define GOODIX_SENSOR_HEIGHT 88
+#define GOODIX_SENSOR_PIXELS (GOODIX_SENSOR_WIDTH * GOODIX_SENSOR_HEIGHT)
+#define GOODIX_SENSOR_RAW12_BYTES (((GOODIX_SENSOR_PIXELS + 3) / 4) * 6)
+
+/* Enroll stages */
+#define GOODIX_ENROLL_SAMPLES 12
+
+/* --- Calibration parameters (from OTP) --- */
+typedef struct
+{
+  guint16  tcode;
+  guint16  delta_fdt;
+  guint16  delta_down;
+  guint16  delta_up;
+  guint16  delta_img;
+  guint16  delta_nav;
+  guint16  dac_h;
+  guint16  dac_l;
+  guint16  dac_delta;
+  gboolean dac_from_otp;
+} GoodixCalibParams;
+
+/* Original OTP default and live adjustment history; current DAC is calib.dac_h. */
+typedef struct
+{
+  guint16 default_dac;
+  guint16 active;
+  guint16 adjustments;
+  guint16 high;
+  guint16 low;
+} GoodixDynamicDacState;
+
+typedef struct
+{
+  /* Receive identity and reverse predecessor travel with the coalesced slot;
+   * scan copies selected work before another packet can replace this slot. */
+  GoodixProfile9FdtEvent event;
+  GoodixFdtEventType type;
+} GoodixFdtNotification;
+
+typedef struct _GoodixTransport GoodixTransport;
+typedef struct _GoodixReader GoodixReader;
+typedef struct _GoodixTls GoodixTls;
+
+/* HAL +0x1e0: requested mode, independent of coordinator and FDT wait state. */
+typedef enum
+{
+  GOODIX_REQUESTED_MODE_CAPTURE = 0,
+  GOODIX_REQUESTED_MODE_SLEEP = 2,
+} GoodixRequestedMode;
+
+/* Independent native response events; the first four retain their existing
+ * readiness bits used by the named command consumers. */
+typedef enum
+{
+  GOODIX_RESPONSE_NONE = -1,
+  GOODIX_RESPONSE_MANUAL,
+  GOODIX_RESPONSE_CONFIG,
+  GOODIX_RESPONSE_SYSTEM,
+  GOODIX_RESPONSE_IMAGE,
+  GOODIX_RESPONSE_REGISTER,
+  GOODIX_RESPONSE_OTP,
+  GOODIX_RESPONSE_PRODUCTION,
+  GOODIX_RESPONSE_FIRMWARE,
+  GOODIX_RESPONSE_COUNT,
+} GoodixResponseSlot;
+
+/* --- Device struct --- */
+struct _FpiDeviceGoodix53x5
+{
+  FpDevice      parent;
+
+  GCancellable *cancel;
+  /* Hardware service authority is independent of the current client action. */
+  GCancellable *session_cancel;
+  gboolean      session_open;
+  /* Exactly one owner drives the hardware at a time: background maintenance
+   * (idle service or a detached deactivation tail), a foreground action, or
+   * the reader join requested by suspend/close. */
+  gboolean      service_active;
+  gboolean      foreground_active;
+  gboolean      action_pending;
+  gboolean      suspend_pending;
+  gboolean      session_suspended;
+  /* Physical stop in flight; service_joined remains owned until its callback. */
+  gboolean      service_draining;
+  void (*service_joined) (FpDevice *dev, gpointer data);
+  gpointer service_joined_data;
+
+  /* Owned by the GM168SEC link: its receive stream, reassembled into whole
+   * packs across transfers. */
+  GByteArray   *pack_rx;
+  /* Owned by the GM168SEC channel: the TLS session images are decrypted
+   * through, replaced at every handshake. HTSEC sensors use gtls instead. */
+  GoodixTls    *tls;
+
+  /* GTLS session (persists across captures) */
+  GoodixGtlsCtx gtls;
+  gboolean      image_error_history;
+  gboolean      gtls_restart_pending;
+  gboolean      gtls_restart_active;
+
+  /* Calibration seeded from OTP; live reads update the current high DAC. */
+  GoodixCalibParams calib;
+  /* Per-device default and last live snapshot of module-owned DAC history. */
+  GoodixDynamicDacState dynamic_dac;
+  GoodixSensorHealth health;
+  /* Latest admitted hardware TX-on plane, independent of consumed setup.
+   * Owned until hardware teardown; recoverable base rejection retains it. */
+  guint16 *hardware_reference;
+  guint64  hardware_reference_id;
+  gboolean hardware_refresh_pending;
+  /* Installed hardware callback/count outlive an individual read attempt. */
+  guint    capture_unread;
+  gboolean captured_enroll_allowed;
+  gboolean capture_callback_pending;
+
+  /* Reassembly buffer for multi-chunk reads */
+  GoodixReassembly rx;
+  /* Validated borrowed view, consumed before the next receive/invalidation. */
+  gboolean         reply_valid;
+  guint8           reply_category;
+  guint8           reply_command;
+  const guint8    *reply_payload;
+  gsize            reply_payload_len;
+  /* Category-D stream and coalesced receive signal survive ACK ownership.
+   * The selected view remains owned until the next receive or invalidation. */
+  GByteArray      *mcu_rx;
+  GBytes          *mcu_reply;
+  gboolean         mcu_ready;
+  /* One handle-owned IN reader and a separately owned command/event waiter. */
+  GoodixReader    *reader;
+  GoodixTransport *transport;
+
+  /* Native response events reset per send; cached bytes survive reset.
+   * The manual cache retains metadata for Linux touch-flag consumers. */
+  guint8 command_response_ready;
+  /* Configuration status of the last 9/2 reply. */
+  guint8 config_response_status;
+  /* The last download (9/0) reply's status byte, and whether the family's
+   * protocol reads it as a failure. */
+  guint8   config_download_status;
+  gboolean config_download_failed;
+  /* Receiver-owned decoded image, independent of the command ACK and of the
+   * captured frame handed to the runtime worker. Readiness resets per send. */
+  guint16 *image_response;
+  gboolean image_response_failed;
+  /* 533c only, from its CONFIG_LOST and RECONNECT events; 53x5 never sets
+   * the fields below up to psk_refresh_pending. */
+  /* Wrapped ACK loss state; a successful download clears it only after the
+   * independent loss notification has been serviced. */
+  gboolean config_lost;
+  gboolean config_restore_pending;
+  gboolean config_restore_active;
+  /* The selected reconnect arms down before any queued reconnect starts. */
+  gboolean reconnect_requested;
+  guint reconnect_pending;
+  /* Set by the 533c channel's config_lost hook; open/resume and reconnect
+   * check the PSK hash while it is set, failed-read recovery keeps it.
+   * Cleared only after a passed check, including across suspend. */
+  gboolean psk_refresh_pending;
+  guint8 manual_response[4 + GOODIX_FDT_BASE_LEN];
+  guint16 manual_touch;
+  /* Parser mutations precede coalesced notification. The latest reverse event
+   * retains the down base installed by its predecessor, not the arm payload. */
+  guint16 fdt_prior_down[GOODIX_PROFILE9_FDT_AREA_COUNT];
+  GoodixFdtNotification pending_fdt;
+  guint8 notice_irq[2];
+  gboolean rx_idle_partial;
+  GoodixRequestedMode requested_mode;
+
+  /* Profile-9 FDT state persists across actions and hardware reinitialization. */
+  GoodixProfile9FdtState profile9_fdt;
+
+  gboolean               open_ref_powered;
+  gboolean               open_usb_reset_required;
+  gboolean               open_recovery_attempted;
+  gboolean               open_gtls_failed;
+
+  /* OTP raw data */
+  guint8 *otp_data;
+  gsize   otp_len;
+
+  /* Firmware version string */
+  gchar *fw_version;
+  /* Shared native cache, including retained unwritten suffixes. Keep the
+   * firmware consumer's 64-byte view while retaining complete framed replies. */
+  union
+  {
+    guint8 shared_response[64];
+    guint8 shared_response_storage[GOODIX_RX_BUF_SIZE];
+  };
+  /* Received lengths preserve Linux short-reply validation independently of
+   * the native event grouping and shared byte overwrites. */
+  gsize shared_response_lengths[GOODIX_RESPONSE_COUNT];
+
+  /* Hardware identity and its validated Milan algorithm subtype. */
+  guint32 chip_id;
+  guint16 milan_sensor_subtype;
+
+  /* Device-keyed identity for the persisted preprocessing subset. */
+  guint8   milan_persistence_identity[32];
+  gboolean milan_persistence_identity_valid;
+
+  /* One admitted TX-on setup generation per valid hardware session. */
+  GoodixMilanGeneration *milan_generation;
+  /* Algorithm state surviving close/reset, released with this device object. */
+  GoodixMilanGeneration *milan_retained_generation;
+  guint64                last_milan_generation_id;
+
+  /* Action-owned state to commit after post-scan hardware cleanup. */
+  GoodixMilanPreprocessState *pending_persistence_state;
+
+  /* TRUE while verifying a PSK write during open. */
+  gboolean psk_write_verify_pending;
+
+  /* GTLS PSK selected for this open. Imported keys are never provisioned by
+   * this driver because the arbitrary-key white-box encoder is not available. */
+  guint8   psk[GOODIX_PSK_LEN];
+  gboolean psk_imported;
+
+  /* USB interface state */
+  gboolean usb_interface_claimed;
+
+  /* A hardware fault requires cold reconstruction on resume or the next
+   * action. Ordinary sleep retains host state and only re-keys GTLS. */
+  gboolean needs_reinit;
+
+  /* Retained for the open/reinitialization parent SSM. */
+  FpiSsm *task_ssm;
+
+  /* Result computed by the CPU worker, delivered when the action completes. */
+  gboolean        pending_result_report;
+  FpiDeviceAction pending_result_action;
+  FpiMatchResult  pending_verify_result;
+  FpPrint        *pending_identify_match;
+  FpPrint        *pending_update_target;
+  GVariant       *pending_update_data;
+  GError         *pending_result_error;
+  GError         *pending_learning_error;
+
+  /* Native CPU work is isolated in one cancellable task. Only its callback on
+   * the action's main context may commit generation state or publish results. */
+  GTask  *milan_task;
+  guint64 action_epoch;
+
+#ifdef GOODIX53X5_DEBUG
+  guint8 *captured_image;   /* native profile-9 diagnostic presentation */
+#endif
+
+  /* Canonical raw 12-bit live frame. Production owns this independently of
+   * debug dumping until the current auth/enroll action consumes or clears it. */
+  guint16 *captured_raw_image;
+
+#ifdef GOODIX53X5_DEBUG
+  GoodixDebugTiming debug_timing;
+  gchar             debug_capture_session_id[37];
+  guint64           debug_chronology;
+#endif
+
+  /* Enrollment tracking */
+  GoodixMilanEnrollmentTransaction *enroll_transaction;
+  gint                              enroll_stage;
+  guint                             enroll_bad_record_count;
+  guint                             enroll_bad_continue_count;
+  gboolean                          pending_enroll_progress;
+  gint                              pending_enroll_stage;
+  GError                           *pending_enroll_error;
+};
+
+/* Returns the sensor's family. Wild OS builds only the 533c (GM168SEC)
+ * family: the HTSEC family provisions a PSK on 5335/5385/5395 sensors, and
+ * no code that writes a key to a sensor is built. */
+static inline const GoodixFamily *
+goodix_family (FpiDeviceGoodix53x5 *self)
+{
+  (void) self;
+  return &goodix_family_gm168sec;
+}
diff --git a/libfprint/drivers/goodix53x5/family.h b/libfprint/drivers/goodix53x5/family.h
new file mode 100644
index 0000000..c7f9b2b
--- /dev/null
+++ b/libfprint/drivers/goodix53x5/family.h
@@ -0,0 +1,185 @@
+/*
+ * Goodix 53x5 driver for libfprint — sensor families
+ * Copyright (C) 2026 goodix-fp-linux-dev contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#pragma once
+
+#include <glib.h>
+
+typedef struct _FpDevice FpDevice;
+typedef struct _FpiSsm FpiSsm;
+typedef struct _FpiDeviceGoodix53x5 FpiDeviceGoodix53x5;
+typedef struct _GoodixTransport GoodixTransport;
+typedef struct _GoodixCmd GoodixCmd;
+
+/* How the bytes of one sensor family reach the driver. */
+typedef struct
+{
+  guint8   usb_interface;
+  guint8   ep_in;
+  guint8   ep_out;
+  /* Returns the bytes to write for the protocol message @msg, or NULL when
+   * the framing cannot carry it. */
+  guint8 *(*frame) (const guint8 *msg, gsize msg_len, gsize *out_len);
+  /* Returns the bytes to write for a raw secure-channel record, or NULL when
+   * the framing cannot carry it; NULL where the channel rides in protocol
+   * messages and nothing is written raw. */
+  guint8 *(*frame_record) (GBytes *record, gsize *out_len);
+  /* Hands the bytes of one completed IN transfer to the receiver through
+   * goodix_rx_cell(), goodix_rx_image() and goodix_mcu_publish(). */
+  void    (*receive) (FpiDeviceGoodix53x5 *self, GoodixTransport *operation,
+                      const guint8 *data, gsize len);
+  /* Drops any partial frame kept between transfers; NULL where none is. */
+  void    (*discard) (FpiDeviceGoodix53x5 *self);
+} GoodixLink;
+
+/* What a message from the sensor means beyond being a reply. */
+typedef enum
+{
+  GOODIX_SENSOR_EVENT_NONE,
+  /* The sensor lost its configuration and keys; the scan restores the
+   * configuration and the next channel handshake re-checks the PSK. */
+  GOODIX_SENSOR_EVENT_CONFIG_LOST,
+  /* The sensor asks for a new secure-channel session, after which finger
+   * detection is armed again. */
+  GOODIX_SENSOR_EVENT_RECONNECT,
+} GoodixSensorEvent;
+
+typedef enum
+{
+  GOODIX_FDT_EVENT_DOWN = 0,
+  GOODIX_FDT_EVENT_UP,
+  GOODIX_FDT_EVENT_REVERSE,
+  GOODIX_FDT_EVENT_NONE,
+  GOODIX_FDT_EVENT_CONFIG,
+  GOODIX_FDT_EVENT_ESD,
+  GOODIX_FDT_EVENT_WAKE,
+  GOODIX_FDT_EVENT_DEACTIVATE,
+} GoodixFdtEventType;
+
+#define GOODIX_FDT_IRQ_DOWN 0x0002
+#define GOODIX_FDT_IRQ_REVERSE 0x0080
+#define GOODIX_FDT_IRQ_REVERSE_ALT 0x0082
+#define GOODIX_FDT_IRQ_UP 0x0200
+
+/* The family's rules of the shared MCU protocol. */
+typedef struct
+{
+  /* Bytes of the wake NOP's zero payload. */
+  gsize    wake_payload_len;
+  /* The EC-control payload that isolates the power button while the sensor
+   * scans; every family ends isolation with three zero bytes. */
+  guint8   ec_on_payload[3];
+  /* Sets the ACK and data budgets, in ms, and permits one timeout retry. */
+  gboolean (*command_budget) (guint8 command, gboolean expect_data,
+                               guint *ack_ms, guint *response_ms);
+  /* Checks whether a failed write may use the command's retry. */
+  gboolean (*retry_write) (const GError *error);
+  /* Checks whether an arm ACK needs a local config download and repeat. */
+  gboolean (*repair_arm) (guint8 status);
+  /* Selects up rather than down after a wake notice. */
+  gboolean (*wake_arm_up) (gboolean waiting_up);
+  /* Publishes a valid ESD notice's IRQ in the family's response storage. */
+  gboolean (*notice_irq) (FpiDeviceGoodix53x5 *self, const guint8 *payload, gsize len);
+  /* Validates and classifies a down/up notification. */
+  GoodixFdtEventType (*fdt_event) (FpiDeviceGoodix53x5 *self,
+                                  const guint8 *payload, gsize len, GError **error);
+  /* TRUE where an ACK that does not come in time is not an error for a
+   * command that expects data: the wait moves on to the data, as the
+   * vendor's _IoHubExec does. FALSE retries the command. */
+  gboolean ack_timeout_waits_for_data;
+  /* Returns the event a complete, valid message carries, or NONE. */
+  GoodixSensorEvent (*event) (guint8 category, guint8 command,
+                              const guint8 *payload, gsize len);
+  /* Checks whether a reply with @category/@command answers @awaited when
+   * both share a response slot. */
+  gboolean (*reply_answers) (guint8 category, guint8 command,
+                             const GoodixCmd *awaited);
+  /* Checks whether a configuration download reply reports success. */
+  gboolean (*download_succeeded) (const guint8 *payload, gsize len);
+  /* Checks whether the driver may send @cmd at all. */
+  gboolean (*may_send) (const GoodixCmd *cmd);
+} GoodixProtocol;
+
+typedef enum
+{
+  /* Decrypted by the established session. */
+  GOODIX_FRAME_DECRYPTED,
+  /* Rejected before the session was established; says nothing about the session. */
+  GOODIX_FRAME_REJECTED,
+  /* Rejected on an established session; counts towards restarting it. */
+  GOODIX_FRAME_REJECTED_IN_SESSION,
+  /* Decrypted, but not an image; the session that decrypted it is sound. */
+  GOODIX_FRAME_INVALID,
+} GoodixFrameStatus;
+
+/* Handshake attempts before a secure-channel start gives up, by what
+ * started it. */
+typedef struct
+{
+  /* Open and resume. */
+  guint open;
+  /* A restart after an image read the channel rejected. */
+  guint after_failed_read;
+  /* A new session the sensor asked for. */
+  guint reconnect;
+} GoodixChannelAttempts;
+
+/* The family's secure channel. */
+typedef enum
+{
+  GOODIX_CHANNEL_START,
+  GOODIX_CHANNEL_FAILED_READ,
+  GOODIX_CHANNEL_RECONNECT,
+} GoodixChannelReason;
+
+typedef struct
+{
+  /* The channel's name in logs. */
+  const char           *name;
+  GoodixChannelAttempts attempts;
+  guint                 retry_delay_ms;
+  /* Returns a new SSM for one handshake attempt. */
+  FpiSsm             *(*attempt_new) (FpDevice *dev, GoodixChannelReason reason);
+  /* Decrypts an encrypted image payload into raw12 bytes in @out. */
+  GoodixFrameStatus   (*decrypt_frame) (FpiDeviceGoodix53x5 *self,
+                                        const guint8 *payload, gsize len,
+                                        guint8 **out, gsize *out_len);
+  /* Counts one undecodable frame; returns TRUE when the channel must be
+   * restarted for it. */
+  gboolean            (*image_error) (FpiDeviceGoodix53x5 *self);
+  /* Checks whether a failed capture may arm while channel recovery is pending. */
+  gboolean            (*rearm_after_capture) (FpiDeviceGoodix53x5 *self);
+  /* TRUE where starting a new session drops the finger-detect arm, so a
+   * restart still pending runs before an arm. */
+  gboolean              restart_disarms;
+  /* Notes an ACK reporting lost configuration, before the shared loss state
+   * changes; NULL where the channel keeps no state for it. */
+  void                (*config_lost) (FpiDeviceGoodix53x5 *self);
+  /* Forgets the session and its keys when the device closes; NULL where
+   * the channel keeps nothing beyond the shared PSK. */
+  void                (*discard) (FpiDeviceGoodix53x5 *self);
+} GoodixChannel;
+
+/* One sensor family: the same GF5288 sensor and pipeline behind its own MCU
+ * firmware. Shared code uses these pieces and never asks which family it
+ * runs. */
+typedef struct
+{
+  GoodixLink     link;
+  GoodixProtocol protocol;
+  GoodixChannel  channel;
+  /* Returns a new SSM running the family's bring-up, from the first probe
+   * to the established secure channel. The open SSM runs it between claiming
+   * the interface and the first configuration download. */
+  FpiSsm      *(*open_new) (FpDevice *dev);
+} GoodixFamily;
+
+/* 533c: wrapped framing on interface 0, TLS 1.2-PSK, GM168SEC MCU. */
+extern const GoodixFamily goodix_family_gm168sec;
diff --git a/libfprint/drivers/goodix53x5/family/gm168sec/channel.c b/libfprint/drivers/goodix53x5/family/gm168sec/channel.c
new file mode 100644
index 0000000..53f047d
--- /dev/null
+++ b/libfprint/drivers/goodix53x5/family/gm168sec/channel.c
@@ -0,0 +1,229 @@
+/*
+ * Goodix 53x5 driver for libfprint — the GM168SEC secure channel (TLS 1.2-PSK)
+ * Copyright (C) 2026 goodix-fp-linux-dev contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#define FP_COMPONENT "goodix53x5"
+
+#include "drivers_api.h"
+#include "driver-private.h"
+#include "device/transport.h"
+#include "device/commands.h"
+#include "device/session.h"
+#include "device/crypto.h"
+#include "family/gm168sec/gm168sec.h"
+#include "family/gm168sec/tls.h"
+
+/* FpParseImage takes exactly the raw12 pixels and their CRC. */
+#define GOODIX_WRAPPED_IMAGE_LEN (GOODIX_SENSOR_RAW12_BYTES + 4)
+
+/* Checks whether @image is a whole raw12 image whose trailing CRC, in the
+ * sensor's byte order, matches its pixels. */
+static gboolean
+goodix_wrapped_image_valid (const guint8 *image, gsize len)
+{
+  return len == GOODIX_WRAPPED_IMAGE_LEN &&
+         goodix_crypto_crc32_mpeg2 (image, GOODIX_SENSOR_RAW12_BYTES) ==
+         goodix_crypto_decode_u32 (image + GOODIX_SENSOR_RAW12_BYTES);
+}
+
+GoodixFrameStatus
+goodix_decrypt_frame_tls (FpiDeviceGoodix53x5 *self, const guint8 *payload,
+                          gsize len, guint8 **out, gsize *out_len)
+{
+  gboolean established = self->tls && goodix_tls_established (self->tls);
+
+  *out = established ? goodix_tls_decrypt (self->tls, payload, len, out_len) : NULL;
+  if (*out && !goodix_wrapped_image_valid (*out, *out_len))
+    {
+      /* The vendor restarts TLS only when the read itself fails. */
+      fp_warn ("Rejecting a %zu-byte image without a valid CRC", *out_len);
+      g_clear_pointer (out, g_free);
+      return GOODIX_FRAME_INVALID;
+    }
+  if (*out)
+    return GOODIX_FRAME_DECRYPTED;
+  return established ? GOODIX_FRAME_REJECTED_IN_SESSION : GOODIX_FRAME_REJECTED;
+}
+
+/* OpenSSL returns a flight; the sensor receives one pack per TLS record. */
+static void
+goodix_tls_send_handler (FpiSsm *ssm, FpDevice *dev)
+{
+  GBytes *out = fpi_ssm_get_data (ssm);
+  gsize len;
+  const guint8 *data = g_bytes_get_data (out, &len);
+  g_autoptr(GError) error = NULL;
+
+  if (g_cancellable_set_error_if_cancelled (goodix_session_io_cancellable (dev), &error))
+    {
+      fpi_ssm_mark_failed (ssm, g_steal_pointer (&error));
+      return;
+    }
+
+  if (fpi_ssm_get_cur_state (ssm) == 1)
+    /* TOD's write and send callback sleep 1 + 2 ms, even on the last record. */
+    fpi_ssm_jump_to_state_delayed (ssm, 0, 3);
+  else if (!len)
+    fpi_ssm_mark_completed (ssm);
+  else
+    {
+      gsize record_len = GOODIX_TLS_RECORD_HEADER + (data[3] << 8 | data[4]);
+      g_autoptr(GBytes) record = g_bytes_new_from_bytes (out, 0, record_len);
+      GBytes *remaining = g_bytes_new_from_bytes (out, record_len, len - record_len);
+
+      fpi_ssm_set_data (ssm, remaining, (GDestroyNotify) g_bytes_unref);
+      goodix_cmd_send_tls_record (ssm, dev, record);
+    }
+}
+
+typedef enum {
+  GOODIX_TLS_PSK_REFRESH,
+  GOODIX_TLS_PSK_CHECK,
+  GOODIX_TLS_REQUEST,
+  GOODIX_TLS_RECV,
+  GOODIX_TLS_STEP,
+  GOODIX_TLS_SENT,
+  GOODIX_TLS_NUM_STATES,
+} GoodixTlsState;
+
+static void
+goodix_tls_received (FpDevice *dev, const GoodixTransportResult *result,
+                      GError *error, gpointer data)
+{
+  FpiSsm *ssm = data;
+
+  if (g_error_matches (error, G_USB_DEVICE_ERROR, G_USB_DEVICE_ERROR_TIMED_OUT))
+    g_clear_error (&error);
+  if (error)
+    fpi_ssm_mark_failed (ssm, error);
+  else
+    fpi_ssm_next_state (ssm);
+}
+
+/* Runs one TLS handshake attempt, the sensor being the client, reading the
+ * PSK hash first when the sensor reported a power loss. Fails when the hash is
+ * not this driver's, the sensor sends a record OpenSSL rejects, or the
+ * handshake runs out of steps. */
+static void
+goodix_tls_ssm_handler (FpiSsm *ssm, FpDevice *dev)
+{
+  FpiDeviceGoodix53x5 *self = FPI_DEVICE_GOODIX53X5 (dev);
+  g_autoptr(GError) error = NULL;
+
+  if (g_cancellable_set_error_if_cancelled (goodix_session_io_cancellable (dev), &error))
+    {
+      fpi_ssm_mark_failed (ssm, g_steal_pointer (&error));
+      return;
+    }
+
+  switch ((GoodixTlsState) fpi_ssm_get_cur_state (ssm))
+    {
+    case GOODIX_TLS_PSK_REFRESH:
+      if (!self->psk_refresh_pending)
+        fpi_ssm_jump_to_state (ssm, GOODIX_TLS_REQUEST);
+      else
+        goodix_cmd_preset_read (ssm, dev, GOODIX_WRAPPED_PSK_HASH_TYPE, GOODIX_PSK_HASH_LEN);
+      break;
+
+    case GOODIX_TLS_PSK_CHECK:
+      if (!goodix_require_current_psk (dev, GOODIX_WRAPPED_PSK_HASH_TYPE, &error))
+        {
+          fpi_ssm_mark_failed (ssm, g_steal_pointer (&error));
+          return;
+        }
+      self->psk_refresh_pending = FALSE;
+      fpi_ssm_next_state (ssm);
+      break;
+
+    case GOODIX_TLS_REQUEST:
+      goodix_transport_reset_mcu (dev);
+      self->mcu_ready = FALSE;
+      g_clear_pointer (&self->tls, goodix_tls_free);
+      self->tls = goodix_tls_new (self->psk, GOODIX_PSK_LEN, &error);
+      if (!self->tls)
+        {
+          fpi_ssm_mark_failed (ssm, g_steal_pointer (&error));
+          return;
+        }
+      goodix_cmd_tls_request (ssm, dev);
+      break;
+
+    case GOODIX_TLS_RECV:
+      goodix_transport_wait_mcu (dev, 50, 0, goodix_tls_received, ssm);
+      break;
+
+    case GOODIX_TLS_STEP:
+      {
+        g_autoptr(GBytes) out = NULL;
+        const guint8 *in = NULL;
+        gsize in_len = 0;
+
+        if (self->mcu_reply)
+          in = g_bytes_get_data (self->mcu_reply, &in_len);
+        if (!goodix_tls_handshake (self->tls, in, in_len, &out, &error))
+          fpi_ssm_mark_failed (ssm, g_steal_pointer (&error));
+        else if (out)
+          {
+            FpiSsm *send = fpi_ssm_new (dev, goodix_tls_send_handler, 2);
+
+            fpi_ssm_set_data (send, g_steal_pointer (&out), (GDestroyNotify) g_bytes_unref);
+            fpi_ssm_start_subsm (ssm, send);
+          }
+        else
+          fpi_ssm_next_state (ssm);
+      }
+      break;
+
+    case GOODIX_TLS_SENT:
+      /* The Geneva handshake sends nothing after the last record. */
+      if (goodix_tls_established (self->tls))
+        fpi_ssm_mark_completed (ssm);
+      else if (!goodix_tls_handshake_pending (self->tls))
+        fpi_ssm_mark_failed (ssm, fpi_device_error_new_msg (
+                              FP_DEVICE_ERROR_PROTO, "TLS handshake did not finish in ten empty waits"));
+      else
+        fpi_ssm_jump_to_state (ssm, GOODIX_TLS_RECV);
+      break;
+
+    case GOODIX_TLS_NUM_STATES:
+      g_assert_not_reached ();
+    }
+}
+
+static void
+goodix_tls_read_restart_handler (FpiSsm *ssm, FpDevice *dev)
+{
+  if (fpi_ssm_get_cur_state (ssm) == GOODIX_TLS_PSK_REFRESH)
+    fpi_ssm_jump_to_state (ssm, GOODIX_TLS_REQUEST);
+  else
+    goodix_tls_ssm_handler (ssm, dev);
+}
+
+FpiSsm *
+goodix_tls_attempt_new (FpDevice *dev, GoodixChannelReason reason)
+{
+  return fpi_ssm_new (dev, reason == GOODIX_CHANNEL_FAILED_READ ?
+                      goodix_tls_read_restart_handler : goodix_tls_ssm_handler,
+                      GOODIX_TLS_NUM_STATES);
+}
+
+/* An OpenSSL session is dead after a failed record, so every undecodable
+ * frame restarts it. */
+gboolean
+goodix_tls_image_error (FpiDeviceGoodix53x5 *self)
+{
+  (void) self;
+  return TRUE;
+}
+
+void
+goodix_tls_discard (FpiDeviceGoodix53x5 *self)
+{
+  g_clear_pointer (&self->tls, goodix_tls_free);
+}
diff --git a/libfprint/drivers/goodix53x5/family/gm168sec/gm168sec.c b/libfprint/drivers/goodix53x5/family/gm168sec/gm168sec.c
new file mode 100644
index 0000000..d9805ad
--- /dev/null
+++ b/libfprint/drivers/goodix53x5/family/gm168sec/gm168sec.c
@@ -0,0 +1,497 @@
+/*
+ * Goodix 53x5 driver for libfprint — the GM168SEC family (27c6:533c)
+ * Copyright (C) 2026 goodix-fp-linux-dev contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+/* 533c is the GF5288 of the 53x5 parts behind a GM168SEC secure element: the
+ * same commands and image pipeline, carried in the wrapped framing of the 51x7
+ * family and secured with standard TLS 1.2-PSK, the sensor being the client. */
+
+#define FP_COMPONENT "goodix53x5"
+
+#include "drivers_api.h"
+#include "driver-private.h"
+#include "device/transport.h"
+#include "family/gm168sec/gm168sec.h"
+#include "family/gm168sec/tls.h"
+
+#include <string.h>
+
+/* Wrapped framing: [flags(1)][length(2 LE)][sum of the first three(1)]
+ * then length bytes. The high nibble of the flags is the family: 0xa packs
+ * carry one protocol message, 0xb packs TLS records, behind a 9-byte prefix
+ * when flag 0x02 is set (0xb2, image data). */
+#define GOODIX_PACK_HEADER         4
+#define GOODIX_PACK_MESSAGE        0xa0
+#define GOODIX_PACK_TLS            0xb0
+#define GOODIX_PACK_FAMILY_MESSAGE 0xa
+#define GOODIX_PACK_FAMILY_TLS     0xb
+#define GOODIX_PACK_TLS_PREFIXED   0x02
+/* The largest TLS record RFC 5246 allows (2^14 + 2048 bytes and its 5-byte
+ * header) behind the prefix; a longer pack is a misread header. */
+#define GOODIX_PACK_MAX_PAYLOAD    (GOODIX_PACK_TLS_DATA_HDR + GOODIX_TLS_RECORD_HEADER + \
+                                    16384 + 2048)
+
+/* Returns the checksum a pack header carries in its fourth byte. */
+static guint8
+goodix_pack_checksum (const guint8 *header)
+{
+  return header[0] + header[1] + header[2];
+}
+
+static void
+goodix_pack_write_header (guint8 *header, guint8 flags, gsize len)
+{
+  header[0] = flags;
+  header[1] = len & 0xff;
+  header[2] = (len >> 8) & 0xff;
+  header[3] = goodix_pack_checksum (header);
+}
+
+/* Returns the payload length a pack header announces, or FALSE when it is
+ * not a header: an unknown family, a wrong checksum or an impossible length. */
+static gboolean
+goodix_pack_read_header (const guint8 *header, gsize *len)
+{
+  guint8 family = header[0] >> 4;
+
+  if ((family != GOODIX_PACK_FAMILY_MESSAGE && family != GOODIX_PACK_FAMILY_TLS) ||
+      goodix_pack_checksum (header) != header[3])
+    return FALSE;
+  *len = header[1] | (header[2] << 8);
+  return *len <= GOODIX_PACK_MAX_PAYLOAD;
+}
+
+/* Returns @data as one pack of kind @flags, zero-padded to whole 64-byte
+ * writes, or NULL when @data does not fit the header's 16-bit length. */
+static guint8 *
+goodix_frame_pack (guint8 flags, const guint8 *data, gsize data_len, gsize *out_len)
+{
+  gsize len = (GOODIX_PACK_HEADER + data_len + GOODIX_USB_CHUNK_SIZE - 1) /
+              GOODIX_USB_CHUNK_SIZE * GOODIX_USB_CHUNK_SIZE;
+  guint8 *framed;
+
+  if (data_len > G_MAXUINT16)
+    return NULL;
+  framed = g_malloc0 (len);
+  goodix_pack_write_header (framed, flags, data_len);
+  memcpy (framed + GOODIX_PACK_HEADER, data, data_len);
+  *out_len = len;
+  return framed;
+}
+
+static guint8 *
+goodix_frame_wrapped (const guint8 *msg, gsize msg_len, gsize *out_len)
+{
+  return goodix_frame_pack (GOODIX_PACK_MESSAGE, msg, msg_len, out_len);
+}
+
+static guint8 *
+goodix_frame_tls_record (GBytes *record, gsize *out_len)
+{
+  gsize len;
+  const guint8 *data = g_bytes_get_data (record, &len);
+
+  return goodix_frame_pack (GOODIX_PACK_TLS, data, len, out_len);
+}
+
+/* Passes one protocol message to the receiver as the 64-byte direct-framing
+ * cells it would have arrived in, so both framings share one parser. */
+static void
+goodix_rx_message (GoodixTransport *operation, const guint8 *msg, gsize len)
+{
+  guint8 cell[GOODIX_USB_CHUNK_SIZE];
+  gsize offset = MIN (len, GOODIX_USB_CHUNK_SIZE);
+
+  goodix_rx_cell (operation, msg, offset);
+  while (offset < len)
+    {
+      gsize n = MIN (len - offset, GOODIX_USB_CHUNK_SIZE - 1);
+
+      cell[0] = msg[0] | 1;
+      memcpy (cell + 1, msg + offset, n);
+      goodix_rx_cell (operation, cell, n + 1);
+      offset += n;
+    }
+}
+
+static void
+goodix_rx_pack (FpiDeviceGoodix53x5 *self, GoodixTransport *operation,
+                guint8 flags, const guint8 *payload, gsize len)
+{
+  if (flags >> 4 == GOODIX_PACK_FAMILY_MESSAGE)
+    {
+      if (len)
+        goodix_rx_message (operation, payload, len);
+    }
+  else
+    {
+      if (flags & GOODIX_PACK_TLS_PREFIXED)
+        {
+          if (len < GOODIX_PACK_TLS_DATA_HDR)
+            return;
+          payload += GOODIX_PACK_TLS_DATA_HDR;
+          len -= GOODIX_PACK_TLS_DATA_HDR;
+        }
+      if (self->tls && goodix_tls_established (self->tls))
+        goodix_rx_image (operation, payload, len);
+      else
+        /* Handshake records share the category-D stream and its waiter. */
+        goodix_mcu_publish (self, payload, len);
+    }
+}
+
+/* Drops the partial pack kept for the next transfer, if any. */
+void
+goodix_drop_pack_stream (FpiDeviceGoodix53x5 *self)
+{
+  g_clear_pointer (&self->pack_rx, g_byte_array_unref);
+}
+
+/* Dispatches every complete pack once @data is appended to the stream,
+ * keeping a partial one for the next transfer; drops the stream at a bad
+ * header. A pack never starts with zero, so its write padding is skipped. */
+static void
+goodix_receive_wrapped (FpiDeviceGoodix53x5 *self, GoodixTransport *operation,
+                        const guint8 *data, gsize len)
+{
+  GByteArray *stream;
+
+  if (!self->pack_rx)
+    self->pack_rx = g_byte_array_new ();
+  stream = self->pack_rx;
+  g_byte_array_append (stream, data, len);
+
+  for (;;)
+    {
+      gsize padding = 0, length;
+
+      while (padding < stream->len && !stream->data[padding])
+        padding++;
+      g_byte_array_remove_range (stream, 0, padding);
+      if (stream->len < GOODIX_PACK_HEADER)
+        return;
+      if (!goodix_pack_read_header (stream->data, &length))
+        {
+          fp_warn ("Dropping %u wrapped bytes with a bad pack header", stream->len);
+          g_byte_array_set_size (stream, 0);
+          return;
+        }
+      if (stream->len < GOODIX_PACK_HEADER + length)
+        return;
+      goodix_rx_pack (self, operation, stream->data[0],
+                      stream->data + GOODIX_PACK_HEADER, length);
+      g_byte_array_remove_range (stream, 0, GOODIX_PACK_HEADER + length);
+    }
+}
+
+/* Checks whether @firmware parses as chip_platform_mode_version, such as
+ * GF5288_GM168SEC_APP_13016, and names the GM168 or GM168SEC platform, as
+ * the vendor's SelfCheck requires. */
+static gboolean
+goodix_wrapped_self_check (const char *firmware)
+{
+  g_auto(GStrv) fields = g_strsplit (firmware, "_", 4);
+  const char *platform;
+
+  if (g_strv_length (fields) != 4)
+    return FALSE;
+  platform = fields[1];
+  return g_ascii_strcasecmp (platform, "GM168") == 0 ||
+         g_ascii_strcasecmp (platform, "GM168SEC") == 0;
+}
+
+GError *
+goodix_gm168sec_check_firmware (const char *firmware)
+{
+  if (!firmware)
+    return fpi_device_error_new_msg (FP_DEVICE_ERROR_PROTO, "Firmware version unreadable");
+  fp_info ("Sensor firmware: %s", firmware);
+  /* Dell's Windows driver leaves the sensor in its bootloader (IAP) after it
+   * sets its own key, until Windows restarts. Nothing here may touch it. */
+  if (strstr (firmware, "_IAP_"))
+    return fpi_device_error_new_msg (FP_DEVICE_ERROR_NOT_SUPPORTED,
+                                     "Sensor is in its bootloader (firmware %s): "
+                                     "Windows Hello has not finished setting it up",
+                                     firmware);
+  if (!goodix_wrapped_self_check (firmware))
+    return fpi_device_error_new_msg (FP_DEVICE_ERROR_NOT_SUPPORTED,
+                                     "Firmware %s is not for this sensor's MCU", firmware);
+  return NULL;
+}
+
+/* The vendor's MCU context waits 1500 ms for every ACK and every reply;
+ * EC control alone gives its ACK 500 ms. Dell's TOD driver never enables
+ * the IoHub retry for this MCU, so every command goes out once; the Windows
+ * driver would resend once after a timeout. */
+static gboolean
+goodix_wrapped_command_budget (guint8 command, gboolean expect_data,
+                              guint *ack_ms, guint *response_ms)
+{
+  (void) expect_data;
+  *ack_ms = command == 0xae ? 500 : 1500;
+  *response_ms = 1500;
+  return FALSE;
+}
+
+static gboolean
+goodix_gm168sec_retry_write (const GError *error)
+{
+  (void) error;
+  return FALSE;
+}
+
+/* ACK flag 0x02, on any command, means the sensor lost its configuration
+ * and needs it downloaded again. */
+#define GOODIX_PROTO_ACK_FLAG_CONFIG_LOST 0x02
+
+static gboolean
+goodix_gm168sec_repair_arm (guint8 status)
+{
+  (void) status;
+  return FALSE;
+}
+
+/* An ACK flagging lost configuration reports that loss; a D0 message asks
+ * for a new secure-channel session rather than carrying channel bytes. */
+static GoodixSensorEvent
+goodix_gm168sec_event (guint8 category, guint8 command, const guint8 *payload, gsize len)
+{
+  if (category == GOODIX_PROTO_CATEGORY_ACK && command == GOODIX_PROTO_CMD_ACK &&
+      len >= 2 && (payload[1] & GOODIX_PROTO_ACK_FLAG_CONFIG_LOST))
+    return GOODIX_SENSOR_EVENT_CONFIG_LOST;
+  if (category == GOODIX_PROTO_CATEGORY_MCU && command == 0)
+    return GOODIX_SENSOR_EVENT_RECONNECT;
+  return GOODIX_SENSOR_EVENT_NONE;
+}
+
+static gboolean
+goodix_gm168sec_wake_arm_up (gboolean waiting_up)
+{
+  (void) waiting_up;
+  return FALSE;
+}
+
+/* A reply answers a command only if its category and command are that
+ * command's, as the vendor's IoHubNotifyDataIn checks. */
+static gboolean
+goodix_gm168sec_reply_answers (guint8 category, guint8 command, const GoodixCmd *awaited)
+{
+  return category == awaited->category && command == awaited->command;
+}
+
+/* The download reply's first byte is 1 on success. */
+static gboolean
+goodix_gm168sec_download_succeeded (const guint8 *payload, gsize len)
+{
+  return len && payload[0] == 1;
+}
+
+/* Checks whether @cmd is a preset-slot read: e4 with a length, a zero
+ * offset, a slot and a zero word. A PSK write may also use e4, but its
+ * payload is a fragment header and data, never this. */
+static gboolean
+goodix_cmd_is_preset_read (const GoodixCmd *cmd)
+{
+  static const guint8 zero[4] = { 0 };
+
+  return cmd->category == GOODIX_PROTO_CATEGORY_PRODUCTION && cmd->command == 0x2 &&
+         cmd->payload_len == 16 && memcmp (cmd->payload + 4, zero, 4) == 0 &&
+         memcmp (cmd->payload + 12, zero, 4) == 0;
+}
+
+/* Checks whether @cmd could change what the sensor stores: any production
+ * command but a preset read (e0 and e2 writes, e4 used as a write), a
+ * firmware write (f0) or an APP erase (a4). */
+static gboolean
+goodix_cmd_writes_sensor (const GoodixCmd *cmd)
+{
+  if (cmd->category == GOODIX_PROTO_CATEGORY_PRODUCTION)
+    return !goodix_cmd_is_preset_read (cmd);
+  return (cmd->category == GOODIX_PROTO_CATEGORY_FIRMWARE && cmd->command == 0x0) ||
+         (cmd->category == GOODIX_PROTO_CATEGORY_SYSTEM && cmd->command == 0x2);
+}
+
+/* 533c returns no firmware in APP mode, so nothing could restore it: the
+ * driver never writes to the sensor.
+ *
+ * Wild OS sends only the commands this driver's 533c path is known to use,
+ * so a command outside the list fails before it reaches the USB endpoint,
+ * whatever it is. None of them changes what the sensor stores: the
+ * configuration download (9/0) and finger-detect arms live in the MCU's RAM
+ * and are sent again after every reset or power loss. */
+static gboolean
+goodix_gm168sec_may_send (const GoodixCmd *cmd)
+{
+  if (goodix_cmd_writes_sensor (cmd))
+    return FALSE;
+
+  switch (cmd->category)
+    {
+    case GOODIX_PROTO_CATEGORY_NOP:
+      /* Wake. */
+      return cmd->command == 0;
+
+    case GOODIX_PROTO_CATEGORY_IMAGE:
+      /* Image request. */
+      return cmd->command == 0;
+
+    case GOODIX_PROTO_CATEGORY_FDT:
+      /* Finger-down, finger-up and manual finger detection. */
+      return cmd->command == GOODIX_PROTO_CMD_FDT_DOWN ||
+             cmd->command == GOODIX_PROTO_CMD_FDT_UP ||
+             cmd->command == GOODIX_PROTO_CMD_FDT_MANUAL;
+
+    case 0x6:
+      /* Sleep mode. */
+      return cmd->command == 0;
+
+    case GOODIX_PROTO_CATEGORY_REGISTER:
+      /* Register read (the chip ID). */
+      return cmd->command == 1;
+
+    case GOODIX_PROTO_CATEGORY_CONFIG:
+      /* Configuration download into the MCU's RAM. */
+      return cmd->command == GOODIX_PROTO_CMD_CONFIG_DOWNLOAD;
+
+    case GOODIX_PROTO_CATEGORY_SYSTEM:
+      /* MCU reset, OTP read, firmware version read, power button isolation. */
+      return cmd->command == 1 || cmd->command == 3 || cmd->command == 4 ||
+             cmd->command == 7;
+
+    case GOODIX_PROTO_CATEGORY_MCU:
+      /* Asks the sensor to start its TLS handshake. */
+      return cmd->command == 0;
+
+    case GOODIX_PROTO_CATEGORY_PRODUCTION:
+      /* The PSK hash read from its preset slot. */
+      return goodix_cmd_is_preset_read (cmd);
+
+    default:
+      return FALSE;
+    }
+}
+
+static gboolean
+goodix_gm168sec_rearm_after_capture (FpiDeviceGoodix53x5 *self)
+{
+  return !self->psk_refresh_pending;
+}
+
+/* Every ACK reports the loss until a restore; only the first is a new power
+ * loss, after which the next handshake checks the PSK. Dell's drivers set
+ * the flag on every such ACK. Keeping the first-loss rule stops later ACKs
+ * setting it again after the check, which would leave a failed capture
+ * unarmed. */
+static void
+goodix_gm168sec_config_lost (FpiDeviceGoodix53x5 *self)
+{
+  if (!self->config_lost)
+    self->psk_refresh_pending = TRUE;
+}
+
+static gboolean
+goodix_gm168sec_notice_irq (FpiDeviceGoodix53x5 *self, const guint8 *payload, gsize len)
+{
+  if (len < sizeof (self->notice_irq))
+    return FALSE;
+  memcpy (self->notice_irq, payload, sizeof (self->notice_irq));
+  return TRUE;
+}
+
+static GoodixFdtEventType
+goodix_gm168sec_fdt_event (FpiDeviceGoodix53x5 *self, const guint8 *payload,
+                          gsize len, GError **error)
+{
+  GoodixFdtEventType type;
+  guint16 irq;
+
+  if (len < 2)
+    goto short_event;
+  irq = payload[0] | ((guint16) payload[1] << 8);
+  switch (irq)
+    {
+    case 0:
+    case 1:
+    case 4:
+    case 8:
+    case 0x10:
+    case 0x20:
+    case 0x40:
+      return GOODIX_FDT_EVENT_NONE;
+    case GOODIX_FDT_IRQ_DOWN:
+      type = GOODIX_FDT_EVENT_DOWN;
+      break;
+    case GOODIX_FDT_IRQ_UP:
+      type = GOODIX_FDT_EVENT_UP;
+      break;
+    case GOODIX_FDT_IRQ_REVERSE:
+    case GOODIX_FDT_IRQ_REVERSE_ALT:
+      type = GOODIX_FDT_EVENT_REVERSE;
+      break;
+    case 0x100:
+      type = GOODIX_FDT_EVENT_NONE;
+      break;
+    default:
+      return GOODIX_FDT_EVENT_CONFIG;
+    }
+  if (len < 4 + GOODIX_FDT_BASE_LEN)
+    goto short_event;
+  if (irq == 0x100)
+    self->manual_touch = payload[2] | ((guint16) payload[3] << 8);
+  return type;
+
+short_event:
+  g_set_error_literal (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_PROTO,
+                       "Unexpected FDT event length");
+  return GOODIX_FDT_EVENT_NONE;
+}
+
+const GoodixFamily goodix_family_gm168sec = {
+  .link = {
+    .usb_interface = 0,
+    .ep_in = 0x03 | FPI_USB_ENDPOINT_IN,
+    .ep_out = 0x01 | FPI_USB_ENDPOINT_OUT,
+    .frame = goodix_frame_wrapped,
+    .frame_record = goodix_frame_tls_record,
+    .receive = goodix_receive_wrapped,
+    .discard = goodix_drop_pack_stream,
+  },
+  .protocol = {
+    .wake_payload_len = 4,
+    /* McuSetEcCtrl builds [enable, mode, enable]; Dell's 533c driver turns
+     * isolation on with mode 0 when a session starts. */
+    .ec_on_payload = { 0x01, 0x00, 0x01 },
+    .command_budget = goodix_wrapped_command_budget,
+    .retry_write = goodix_gm168sec_retry_write,
+    .repair_arm = goodix_gm168sec_repair_arm,
+    .wake_arm_up = goodix_gm168sec_wake_arm_up,
+    .notice_irq = goodix_gm168sec_notice_irq,
+    .fdt_event = goodix_gm168sec_fdt_event,
+    .ack_timeout_waits_for_data = TRUE,
+    .event = goodix_gm168sec_event,
+    .reply_answers = goodix_gm168sec_reply_answers,
+    .download_succeeded = goodix_gm168sec_download_succeeded,
+    .may_send = goodix_gm168sec_may_send,
+  },
+  .channel = {
+    .name = "TLS",
+    /* Start makes one TLS call and one retry; StartTlsThread, after a failed
+     * read, makes one; LogicEvtTlsConn makes at most two. */
+    .attempts = { .open = 2, .after_failed_read = 1, .reconnect = 2 },
+    .retry_delay_ms = 0,
+    .attempt_new = goodix_tls_attempt_new,
+    .decrypt_frame = goodix_decrypt_frame_tls,
+    .image_error = goodix_tls_image_error,
+    .rearm_after_capture = goodix_gm168sec_rearm_after_capture,
+    .restart_disarms = TRUE,
+    .config_lost = goodix_gm168sec_config_lost,
+    .discard = goodix_tls_discard,
+  },
+  .open_new = goodix_gm168sec_open_new,
+};
