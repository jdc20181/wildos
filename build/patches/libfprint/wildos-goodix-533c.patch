+       metrics[GOODIX_MILAN_POLICY_METRIC_COMBINED] < 215 &&
+       image_coverage < 87) ||
+      (state[0] >= 1 && metrics[GOODIX_MILAN_POLICY_METRIC_DETAIL] < 208 &&
+       metrics[GOODIX_MILAN_POLICY_METRIC_COMBINED] < 214 &&
+       image_coverage < 85) ||
