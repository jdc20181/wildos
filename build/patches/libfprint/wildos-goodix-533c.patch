+#include <glib.h>
+
+typedef struct
+{
+  const char *name;
+  int32_t candidate_flag;
+  int32_t metric1;
+  int32_t metric4;
+  int32_t metric5;
+  int32_t metric9;
+  int32_t initial_sum;
+  int32_t initial_count;
+  int32_t winner5;
+  int32_t winner1;
