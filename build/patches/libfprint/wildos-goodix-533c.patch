+static int32_t
+milan_match_scan_raw_s32 (int32_t first,
+                          uint32_t first_coordinate,
+                          int32_t second,
+                          uint32_t second_coordinate,
+                          int32_t translation)
+{
+  return goodix_milan_transform_affine_s32 (
