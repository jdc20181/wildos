+goodix_cmd_request_image (FpiSsm *ssm, FpDevice *dev,
+                          gboolean tx_enable, gboolean hv_enable,
+                          gboolean is_finger, guint16 dac)
+{
+  goodix_cmd_request_image_result (ssm, dev, tx_enable, hv_enable, is_finger, dac, NULL);
+}
